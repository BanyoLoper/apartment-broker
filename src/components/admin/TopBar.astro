---
interface Props {
  title: string;
  subtitle?: string;
  primaryAction?: { label: string; href: string };
  secondaryAction?: { label: string; href: string };
}
const { title, subtitle, primaryAction, secondaryAction } = Astro.props;
---

<header class="ab-topbar">
  <div>
    {subtitle && <span class="ab-eyebrow">{subtitle}</span>}
    <h1 class="ab-h1 ab-topbar-title">{title}</h1>
  </div>
  <div class="ab-topbar-actions">
    {secondaryAction && (
      <a class="ab-topbar-btn ab-topbar-btn--ghost" href={secondaryAction.href}>{secondaryAction.label}</a>
    )}
    {primaryAction && (
      <a class="ab-topbar-btn ab-topbar-btn--primary" href={primaryAction.href}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14 M5 12h14"/></svg>
        {primaryAction.label}
      </a>
    )}
  </div>
</header>

<style>
  .ab-topbar {
    display: flex; align-items: flex-end; justify-content: space-between;
    padding: 32px 32px 24px; border-bottom: 1px solid var(--ezra-border);
    background: var(--ezra-bg);
  }
  .ab-topbar-title {
    margin: 8px 0 0;
    font-family: var(--ezra-font-display);
    font-size: 36px; font-weight: 600;
    color: var(--ezra-fg); letter-spacing: -0.015em;
  }
  .ab-topbar-actions { display: flex; gap: 8px; }
  .ab-topbar-btn {
    padding: 10px 16px; border-radius: var(--ezra-radius-md);
    text-decoration: none; font-size: 12px; font-weight: 500;
    letter-spacing: 0.04em;
    display: inline-flex; align-items: center; gap: 6px; border: 1px solid transparent; cursor: pointer;
    transition: background var(--ezra-dur-fast), color var(--ezra-dur-fast);
  }
  .ab-topbar-btn--ghost {
    background: transparent;
    border-color: var(--ezra-border-strong);
    color: var(--ezra-fg-muted);
  }
  .ab-topbar-btn--ghost:hover { color: var(--ezra-fg); border-color: var(--ezra-fg); }
  .ab-topbar-btn--primary { background: var(--ezra-fg); color: var(--ezra-bg); }
  .ab-topbar-btn--primary:hover { opacity: 0.85; }
</style>
