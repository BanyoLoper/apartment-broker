---
interface Props { label: string; }
const { label } = Astro.props;
---
<label class="ab-field">
  <span class="ab-eyebrow">{label}</span>
  <slot />
</label>

<style is:global>
  .ab-field input, .ab-field select, .ab-field textarea {
    padding: 10px 12px; border-radius: 4px;
    border: 1px solid var(--ezra-border-strong);
    background: var(--ezra-surface); color: var(--ezra-fg);
    font-size: 14px; width: 100%;
    font-family: inherit;
    transition: border-color var(--ezra-dur-fast);
  }
  .ab-field input:focus, .ab-field select:focus, .ab-field textarea:focus {
    border-color: var(--ezra-fg);
    outline: none;
  }
  .ab-field textarea { resize: vertical; min-height: 80px; }
</style>

<style>
  .ab-field { display: flex; flex-direction: column; gap: 6px; }
</style>
