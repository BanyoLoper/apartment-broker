---
interface Props { label: string; }
const { label } = Astro.props;
---
<label class="ab-field">
  <span class="ab-eyebrow">{label}</span>
  <slot />
</label>

<style is:global>
  .ab-field input, .ab-field select, .ab-field textarea {
    padding: 10px 12px; border-radius: 8px;
    border: 1px solid var(--ab-border-strong);
    background: #fff; font-size: 14px; width: 100%;
    font-family: inherit;
  }
  .ab-field textarea { resize: vertical; min-height: 80px; }
</style>

<style>
  .ab-field { display: flex; flex-direction: column; gap: 6px; }
</style>
