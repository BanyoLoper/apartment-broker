---
interface Props {
  label: string;
  name: string;
  defaultChecked?: boolean;
}
const { label, name, defaultChecked } = Astro.props;
---
<label class="ab-toggle">
  <span>{label}</span>
  <input type="checkbox" name={name} checked={defaultChecked} />
  <span class="ab-toggle-track" aria-hidden="true"><span class="ab-toggle-thumb"></span></span>
</label>

<style>
  .ab-toggle {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px; border: 1px solid var(--ab-border);
    border-radius: 10px; background: #fff;
    font-size: 14px; cursor: pointer;
  }
  .ab-toggle input { display: none; }
  .ab-toggle-track {
    width: 40px; height: 22px; border-radius: 999px;
    background: var(--ab-bone-300); position: relative;
    transition: background 140ms var(--ab-ease-standard);
  }
  .ab-toggle-thumb {
    position: absolute; top: 2px; left: 2px;
    width: 18px; height: 18px; border-radius: 999px;
    background: #fff;
    transition: left 140ms var(--ab-ease-standard);
  }
  .ab-toggle input:checked ~ .ab-toggle-track { background: var(--ab-terracotta-500); }
  .ab-toggle input:checked ~ .ab-toggle-track .ab-toggle-thumb { left: 20px; }
</style>
