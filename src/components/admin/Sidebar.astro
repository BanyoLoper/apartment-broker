---
interface Props {
  active: 'listings' | 'visits' | 'tenants' | 'contracts' | 'metrics' | 'leads';
  brokerName?: string;
}
const { active, brokerName = 'Broker' } = Astro.props;
const items = [
  { k: 'listings', label: 'Publicaciones', href: '/admin/publicaciones', icon: 'M3 21 V8 L12 3 L21 8 V21 Z M9 21 V14 H15 V21' },
  { k: 'leads', label: 'Leads', href: '/admin/leads', icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z' },
  { k: 'visits', label: 'Visitas', href: '/admin/visitas', icon: 'M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0Z' },
  { k: 'tenants', label: 'Inquilinos', href: '/admin/inquilinos', icon: 'M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M5 21v-1a7 7 0 0 1 14 0v1' },
  { k: 'metrics', label: 'Métricas', href: '/admin/metricas', icon: 'M3 3v18h18 M7 14l4-4 4 4 5-5' },
] as const;
const initials = brokerName.split(' ').map((s) => s[0]).slice(0, 2).join('');
---

<nav class="ezra-sidebar">
  <div class="ezra-sidebar-brand">
    <a class="ezra-sidebar-mark" href="/" title="Ver sitio público">
      <span class="ezra-sidebar-name">EZRA</span>
      <span class="ezra-sidebar-sub">Real Estate</span>
    </a>
    <span class="ezra-sidebar-tag">Admin</span>
  </div>

  <div class="ezra-sidebar-items">
    {items.map((it) => (
      <a class={`ezra-sidebar-item ${active === it.k ? 'is-active' : ''}`} href={it.href}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d={it.icon}/>
        </svg>
        {it.label}
      </a>
    ))}
  </div>

  <form class="ezra-sidebar-footer" method="post" action="/api/auth/logout">
    <div class="ezra-sidebar-avatar">{initials}</div>
    <div class="ezra-sidebar-user">
      <div class="ezra-sidebar-user-name">{brokerName}</div>
      <button type="submit" class="ezra-sidebar-logout">Cerrar sesión</button>
    </div>
  </form>
</nav>

<style>
  .ezra-sidebar {
    width: 240px; min-height: 100vh; position: sticky; top: 0;
    background: #0A0A0A; color: #FFFFFF;
    padding: 28px 20px;
    display: flex; flex-direction: column;
    border-right: 1px solid rgba(255,255,255,0.08);
  }
  .ezra-sidebar-brand {
    display: flex; flex-direction: column; gap: 8px;
    margin-bottom: 40px; padding: 0 4px;
  }
  .ezra-sidebar-mark {
    display: flex; flex-direction: column; gap: 1px; line-height: 1;
    text-decoration: none; color: #FFF;
  }
  .ezra-sidebar-name {
    font-family: var(--ezra-font-display);
    font-size: 26px; font-weight: 500;
    letter-spacing: 0.32em; padding-left: 0.32em;
    color: #FFF;
  }
  .ezra-sidebar-sub {
    font-size: 8px; font-weight: 500;
    letter-spacing: 0.42em; text-transform: uppercase;
    color: rgba(255,255,255,0.55);
  }
  .ezra-sidebar-tag {
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.32em; text-transform: uppercase;
    color: rgba(255,255,255,0.42);
    padding-top: 8px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .ezra-sidebar-items { display: flex; flex-direction: column; gap: 2px; }
  .ezra-sidebar-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px; border-radius: var(--ezra-radius-md);
    color: rgba(255,255,255,0.62); text-decoration: none;
    font-size: 13px; font-weight: 400;
    transition: color var(--ezra-dur-fast), background var(--ezra-dur-fast);
  }
  .ezra-sidebar-item:hover { color: #FFF; background: rgba(255,255,255,0.04); }
  .ezra-sidebar-item.is-active {
    background: rgba(255,255,255,0.08);
    color: #FFF; font-weight: 500;
    border-left: 2px solid var(--ezra-copper);
    padding-left: 10px;
  }

  .ezra-sidebar-footer {
    margin-top: auto; padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.08);
    display: flex; align-items: center; gap: 10px;
  }
  .ezra-sidebar-avatar {
    width: 32px; height: 32px; border-radius: 999px;
    background: var(--ezra-copper); color: #FFF;
    display: flex; align-items: center; justify-content: center;
    font-weight: 600; font-size: 12px;
  }
  .ezra-sidebar-user-name { font-size: 13px; font-weight: 500; color: #FFF; }
  .ezra-sidebar-logout {
    background: none; border: none; color: rgba(255,255,255,0.45);
    padding: 0; font-size: 10px; cursor: pointer; text-align: left;
    letter-spacing: 0.06em; text-transform: uppercase;
  }
  .ezra-sidebar-logout:hover { color: #FFF; }
</style>
