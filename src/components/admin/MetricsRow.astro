---
interface Metric {
  k: string;
  v: string;
  delta: string;
  tone: 'jade' | 'neutral';
}
interface Props { metrics: Metric[]; }
const { metrics } = Astro.props;
---
<div class="ab-metrics">
  {metrics.map((m) => (
    <div class="ab-metric">
      <div class="ab-eyebrow">{m.k}</div>
      <div class="ab-metric-v">{m.v}</div>
      <div class={`ab-metric-d ab-metric-d--${m.tone}`}>{m.delta}</div>
    </div>
  ))}
</div>

<style>
  .ab-metrics {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px; padding: 24px 32px 0;
  }
  .ab-metric {
    background: var(--ezra-surface);
    border: 1px solid var(--ezra-border);
    border-radius: var(--ezra-radius-lg);
    padding: 24px;
  }
  .ab-metric-v {
    font-family: var(--ezra-font-display);
    font-size: 32px; font-weight: 600;
    color: var(--ezra-fg); margin-top: 6px;
    letter-spacing: -0.015em; white-space: nowrap;
  }
  .ab-metric-d { font-size: 12px; margin-top: 4px; font-weight: 300; }
  .ab-metric-d--jade { color: var(--ezra-success); }
  .ab-metric-d--neutral { color: var(--ezra-fg-muted); }
</style>
