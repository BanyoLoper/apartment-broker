---
interface Props { label: string; v: string; }
const { label, v } = Astro.props;
---
<div class="ab-feat">
  <div class="ab-eyebrow">{label}</div>
  <div class="ab-feat-v">{v}</div>
</div>

<style>
  .ab-feat { border-top: 1px solid var(--ab-border); padding-top: 12px; }
  .ab-feat-v {
    font-family: var(--ab-font-display); font-size: 22px; font-weight: 500;
    color: var(--ab-ink-900); margin-top: 4px; letter-spacing: -0.01em;
  }
</style>
