---
interface Props { label: string; v: string; }
const { label, v } = Astro.props;
---
<div class="ezra-feat">
  <div class="ezra-feat-label">{label}</div>
  <div class="ezra-feat-v">{v}</div>
</div>

<style>
  .ezra-feat {
    border-top: 1px solid var(--ezra-border);
    padding-top: 14px;
  }
  .ezra-feat-label {
    font-size: 10px; font-weight: 500;
    letter-spacing: var(--ezra-track-wide);
    text-transform: uppercase;
    color: var(--ezra-fg-soft);
  }
  .ezra-feat-v {
    margin-top: 6px;
    font-family: var(--ezra-font-display);
    font-size: 24px; font-weight: 500;
    color: var(--ezra-fg);
    letter-spacing: -0.01em;
  }
</style>
