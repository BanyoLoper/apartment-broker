---
// EZRA listing card — composición auto-generada estilo Hamburgo:
//   foto full-bleed + overlay editorial superior con name/tagline/precio
//   + watermark EZRA + tira inferior con specs y servicios.
import type { Listing } from '../../lib/db';
interface Props {
  listing: Listing;
  /** Galería para transicionar en hover. Si falta, usa solo la portada. */
  images?: string[];
  /** Cuando true, prioriza la imagen como hero (no lazy). */
  priority?: boolean;
}
const { listing, images, priority = false } = Astro.props;

const cover = listing.cover_image || '/assets/placeholder-apt-1.svg';
const gallery = images && images.length ? images : [cover];
const subtype = listing.furnished ? 'Depto. Amueblado' : 'Departamento';
const specs: string[] = [`${listing.area_m2} m²`, `${listing.beds} rec`, `${listing.baths} baño`];
if (listing.parking) specs.push(`${listing.parking} estac`);
specs.push('amenidades');
---

<div class="ezra-card-wrap">
<a class="ezra-card" href={`/departamentos/${listing.slug}`} aria-label={`${listing.name} en ${listing.colonia}`}>
  <article class="ezra-card-frame">
    <div class="ezra-card-photos">
      {gallery.map((src, i) => (
        <img
          src={src}
          alt={i === 0 ? `${listing.name}, ${listing.colonia}` : ''}
          class={`ezra-card-photo ${i === 0 ? 'is-active' : ''}`}
          loading={priority && i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ))}
    </div>
    <div class="ezra-card-scrim-top"></div>
    <div class="ezra-card-scrim-bottom"></div>

    <header class="ezra-card-overlay">
      <p class="ezra-card-eyebrow">{listing.name} · Col. {listing.colonia}</p>
      <h3 class="ezra-card-title">
        <strong>{subtype}</strong>
      </h3>
      <p class="ezra-card-price">
        <span class="ezra-card-price-label">Renta</span>
        <span class="ezra-card-price-amount">${listing.price_mxn.toLocaleString('es-MX')}</span>
      </p>
      {listing.utilities_included && (
        <p class="ezra-card-utilities">{listing.utilities_included}</p>
      )}
    </header>

    <div class="ezra-card-watermark" aria-hidden="true">
      <span class="ezra-card-watermark-name">EZRA</span>
      <span class="ezra-card-watermark-sub">Real Estate</span>
    </div>

    <footer class="ezra-card-specs">
      <p class="ezra-card-specs-line">
        {specs.map((s, i) => (
          <>
            {i > 0 && <span class="ezra-card-dot">·</span>}
            <span>{s}</span>
          </>
        ))}
      </p>
    </footer>
  </article>
</a>
  {gallery.length > 1 && (
    <>
      <button type="button" class="ezra-card-nav ezra-card-nav--prev" aria-label="Foto anterior">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="ezra-card-nav ezra-card-nav--next" aria-label="Foto siguiente">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </>
  )}
</div>

<script>
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  document.querySelectorAll<HTMLElement>('.ezra-card-wrap').forEach((wrap) => {
    const photos = Array.from(wrap.querySelectorAll<HTMLElement>('.ezra-card-photo'));
    if (photos.length < 2) return;
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      photos[i].classList.remove('is-active');
      i = (n + photos.length) % photos.length;
      photos[i].classList.add('is-active');
    };

    // Botones (móvil / dispositivos táctiles). Son hermanos del <a>, así que
    // no navegan al detalle; aun así prevenimos por seguridad.
    const stop = (e: Event) => e.preventDefault();
    wrap.querySelector('.ezra-card-nav--prev')?.addEventListener('click', (e) => { stop(e); show(i - 1); });
    wrap.querySelector('.ezra-card-nav--next')?.addEventListener('click', (e) => { stop(e); show(i + 1); });

    // Auto-transición al hover solo en escritorio (con hover real).
    if (canHover) {
      const card = wrap.querySelector('.ezra-card');
      card?.addEventListener('mouseenter', () => {
        timer = window.setInterval(() => show(i + 1), 1100);
      });
      card?.addEventListener('mouseleave', () => {
        if (timer) window.clearInterval(timer);
        timer = undefined;
        show(0);
      });
    }
  });
</script>

<style>
  .ezra-card-wrap { position: relative; }
  .ezra-card {
    display: block;
    text-decoration: none;
    color: #fff;
    --card-radius: var(--ezra-radius-lg);
  }

  /* Botones de navegación de fotos (solo dispositivos táctiles). */
  .ezra-card-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    z-index: 4;
    width: 42px; height: 42px; border-radius: 999px;
    display: none; align-items: center; justify-content: center;
    background: rgba(15,15,15,0.5); color: #fff;
    border: 1px solid rgba(255,255,255,0.35);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    cursor: pointer;
    transition: background var(--ezra-dur-fast);
  }
  .ezra-card-nav:active { background: rgba(15,15,15,0.8); }
  .ezra-card-nav--prev { left: 12px; }
  .ezra-card-nav--next { right: 12px; }
  @media (hover: none), (pointer: coarse) {
    .ezra-card-nav { display: inline-flex; }
  }
  .ezra-card-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--card-radius);
    overflow: hidden;
    background: var(--ezra-ink-900);
    box-shadow: var(--ezra-shadow-2);
    transition: transform var(--ezra-dur-base) var(--ezra-ease-standard),
                box-shadow var(--ezra-dur-base) var(--ezra-ease-standard);
  }
  .ezra-card:hover .ezra-card-frame {
    transform: translateY(-2px);
    box-shadow: var(--ezra-shadow-3);
  }
  .ezra-card-photos { position: absolute; inset: 0; }
  .ezra-card-photo {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    opacity: 0;
    transition: opacity 700ms var(--ezra-ease-standard),
                transform 600ms var(--ezra-ease-standard);
  }
  .ezra-card-photo.is-active { opacity: 1; }
  .ezra-card:hover .ezra-card-photo { transform: scale(1.03); }

  .ezra-card-scrim-top {
    position: absolute; inset: 0 0 auto 0; height: 55%;
    background: var(--ezra-scrim-top);
    pointer-events: none;
  }
  .ezra-card-scrim-bottom {
    position: absolute; inset: auto 0 0 0; height: 32%;
    background: var(--ezra-scrim-bottom);
    pointer-events: none;
  }

  .ezra-card-overlay {
    position: absolute; left: 24px; right: 24px; top: 24px;
    display: flex; flex-direction: column; gap: 10px;
    color: #FFF;
  }
  .ezra-card-eyebrow {
    margin: 0;
    font-size: 11px; font-weight: 500;
    letter-spacing: var(--ezra-track-mid);
    text-transform: uppercase;
    color: rgba(255,255,255,0.78);
  }
  .ezra-card-title {
    margin: 0;
    font-family: var(--ezra-font-body);
    font-weight: 800;
    font-size: 26px;
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: #FFF;
  }
  .ezra-card-price {
    margin: 4px 0 0;
    display: flex; align-items: baseline; gap: 8px;
    color: #FFF;
  }
  .ezra-card-price-label {
    font-size: 14px; font-weight: 300;
    color: rgba(255,255,255,0.78);
    text-transform: lowercase;
  }
  .ezra-card-price-amount {
    font-family: var(--ezra-font-body);
    font-weight: 800; font-size: 38px;
    letter-spacing: -0.02em; line-height: 1;
    color: #FFF;
  }
  .ezra-card-utilities {
    margin: 0;
    font-size: 11px;
    color: rgba(255,255,255,0.72);
    letter-spacing: 0.04em;
  }

  .ezra-card-watermark {
    position: absolute; left: 50%; bottom: 86px;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    pointer-events: none;
    opacity: 0.78;
  }
  .ezra-card-watermark-name {
    font-family: var(--ezra-font-display);
    font-size: 22px; font-weight: 500;
    letter-spacing: 0.32em;
    color: #FFF;
    padding-left: 0.32em;
  }
  .ezra-card-watermark-sub {
    font-size: 8px; font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.78);
  }

  .ezra-card-specs {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 18px 24px;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    color: #FFF;
  }
  .ezra-card-specs-line {
    margin: 0;
    font-size: 12px; font-weight: 500;
    letter-spacing: 0.04em;
    color: #FFF;
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .ezra-card-dot { color: rgba(255,255,255,0.55); }

  @media (max-width: 640px) {
    .ezra-card-title { font-size: 22px; }
    .ezra-card-price-amount { font-size: 32px; }
    .ezra-card-overlay { left: 18px; right: 18px; top: 18px; }
    .ezra-card-specs { padding: 14px 18px; }
  }
</style>
