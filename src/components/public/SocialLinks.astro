<style>
  .ezra-social { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .ezra-social-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 999px;
    color: var(--ezra-fg-muted);
    border: 1px solid var(--ezra-border-strong);
    text-decoration: none;
    transition: color var(--ezra-dur-fast) var(--ezra-ease-standard),
                border-color var(--ezra-dur-fast),
                background var(--ezra-dur-fast),
                transform var(--ezra-dur-fast);
  }
  .ezra-social-link:hover {
    color: var(--ezra-bg);
    background: var(--ezra-fg);
    border-color: var(--ezra-fg);
    transform: translateY(-1px);
  }
  .ezra-social-link svg { display: block; }
</style>
