---
const cols = [
  { heading: 'Producto', links: ['Departamentos', 'Colonias', 'Tour 3D'] },
  { heading: 'Empresa', links: ['Sobre nosotros', 'Prensa', 'Contacto'] },
  { heading: 'Legal', links: ['Términos', 'Privacidad', 'Cookies'] },
];
const year = new Date().getFullYear();
---

<footer class="ab-footer">
  <div class="ab-footer-inner">
    <div>
      <img src="/assets/logo-mark.svg" alt="" width="48" height="48" />
      <p class="ab-footer-tagline">
        Departamentos curados en Roma, Condesa, Juárez y Polanco. Somos el dueño y el broker — sin intermediarios.
      </p>
    </div>
    {cols.map((c) => (
      <div class="ab-footer-col">
        <span class="ab-footer-heading">{c.heading}</span>
        {c.links.map((l) => <a href="#">{l}</a>)}
      </div>
    ))}
  </div>
  <div class="ab-footer-bar">
    <span>© {year} ApartmentBroker · Ciudad de México</span>
    <span class="ab-mono-tag">RFC ABK260101 · CDMX</span>
  </div>
</footer>

<style>
  .ab-footer {
    background: var(--ab-ink-900);
    color: var(--ab-bone-50);
    margin-top: 96px;
    padding: 64px 32px 32px;
    background-image: url(/assets/pattern-talavera.svg);
    background-size: 200px;
    background-blend-mode: soft-light;
  }
  .ab-footer-inner {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px;
  }
  .ab-footer-tagline { max-width: 320px; margin-top: 16px; color: rgba(250,247,242,0.7); }
  .ab-footer-col { display: flex; flex-direction: column; gap: 10px; }
  .ab-footer-heading { font: var(--ab-text-eyebrow); letter-spacing: 0.14em; text-transform: uppercase; color: rgba(250,247,242,0.5); }
  .ab-footer-col a { font-size: 14px; color: var(--ab-bone-50); text-decoration: none; }
  .ab-footer-bar {
    max-width: 1280px; margin: 48px auto 0; padding-top: 24px;
    border-top: 1px solid rgba(250,247,242,0.12);
    display: flex; justify-content: space-between;
    font: var(--ab-text-caption); color: rgba(250,247,242,0.5);
  }
  .ab-mono-tag { font-family: var(--ab-font-mono); }
  @media (max-width: 768px) {
    .ab-footer-inner { grid-template-columns: 1fr 1fr; }
    .ab-footer-bar { flex-direction: column; gap: 8px; }
  }
</style>
