---
const cols = [
  { heading: 'Producto', links: [{ l: 'Departamentos', h: '/departamentos' }, { l: 'Colonias', h: '/colonias' }, { l: 'Cómo funciona', h: '/como-funciona' }] },
  { heading: 'Empresa', links: [{ l: 'Sobre nosotros', h: '#' }, { l: 'Contacto', h: '#contacto' }] },
  { heading: 'Legal', links: [{ l: 'Términos', h: '#' }, { l: 'Privacidad', h: '#' }, { l: 'Cookies', h: '#' }] },
];
const year = new Date().getFullYear();
---

<footer class="ezra-footer">
  <div class="ezra-footer-inner">
    <div class="ezra-footer-brand">
      <div class="ezra-footer-mark">
        <span class="ezra-footer-name">EZRA</span>
        <span class="ezra-footer-sub">Real Estate</span>
      </div>
      <p class="ezra-footer-tagline">
        Departamentos amueblados curados en Roma, Condesa, Juárez y Polanco. Renta directa con el dueño — sin intermediarios.
      </p>
    </div>
    {cols.map((c) => (
      <div class="ezra-footer-col">
        <span class="ezra-footer-heading">{c.heading}</span>
        {c.links.map((l) => <a href={l.h}>{l.l}</a>)}
      </div>
    ))}
  </div>
  <div class="ezra-footer-bar">
    <span>© {year} EZRA Real Estate · Ciudad de México</span>
    <span class="ezra-footer-mono">Capitalia · Juárez</span>
  </div>
</footer>

<style>
  .ezra-footer {
    background: var(--ezra-bg-deep);
    color: var(--ezra-fg);
    margin-top: 96px;
    padding: 72px 32px 32px;
    border-top: 1px solid var(--ezra-border);
  }
  .ezra-footer-inner {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px;
  }
  .ezra-footer-brand { max-width: 360px; }
  .ezra-footer-mark { display: flex; flex-direction: column; gap: 2px; line-height: 1; }
  .ezra-footer-name {
    font-family: var(--ezra-font-display);
    font-size: 36px; font-weight: 500;
    letter-spacing: 0.32em; color: var(--ezra-fg);
    padding-left: 0.32em;
  }
  .ezra-footer-sub {
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.42em; text-transform: uppercase;
    color: var(--ezra-fg-muted);
  }
  .ezra-footer-tagline {
    margin-top: 24px; max-width: 320px;
    color: var(--ezra-fg-muted); line-height: 1.55;
  }
  .ezra-footer-col { display: flex; flex-direction: column; gap: 12px; }
  .ezra-footer-heading {
    font-size: 11px; font-weight: 500;
    letter-spacing: var(--ezra-track-wide);
    text-transform: uppercase;
    color: var(--ezra-fg-soft);
  }
  .ezra-footer-col a {
    font-size: 14px; color: var(--ezra-fg-muted);
    text-decoration: none;
    transition: color var(--ezra-dur-fast) var(--ezra-ease-standard);
  }
  .ezra-footer-col a:hover { color: var(--ezra-fg); }
  .ezra-footer-bar {
    max-width: 1280px; margin: 64px auto 0; padding-top: 24px;
    border-top: 1px solid var(--ezra-border);
    display: flex; justify-content: space-between;
    font-size: 11px; letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ezra-fg-soft);
  }
  .ezra-footer-mono { font-family: var(--ezra-font-mono); letter-spacing: 0.12em; }
  @media (max-width: 768px) {
    .ezra-footer-inner { grid-template-columns: 1fr 1fr; }
    .ezra-footer-bar { flex-direction: column; gap: 8px; align-items: flex-start; }
  }
</style>
