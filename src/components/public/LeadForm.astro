---
interface Props {
  whatsappNumber: string;
}
const { whatsappNumber } = Astro.props;
const waLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola, me interesa vender / rentar / comprar una propiedad con EZRA.')}`;
---

<section id="contacto" class="ezra-lead">
  <div class="ezra-lead-inner">
    <div class="ezra-lead-intro">
      <span class="ezra-eyebrow-wide">Contacto</span>
      <h2 class="ezra-lead-title">¿Quieres vender, rentar o comprar?</h2>
      <p class="ezra-lead-lede">
        Cuéntanos qué necesitas y un asesor de EZRA te contacta. Atención directa,
        personalizada y sin intermediarios.
      </p>
      <a href={waLink} class="ezra-lead-wa" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.78 11.78 0 0012.06 0C5.48 0 .13 5.36.13 11.94c0 2.11.55 4.18 1.59 6.01L0 24l6.24-1.63a11.92 11.92 0 005.82 1.49h.01c6.58 0 11.94-5.36 11.94-11.94 0-3.19-1.24-6.19-3.49-8.44zM12.07 21.5h-.01a9.53 9.53 0 01-4.86-1.33l-.35-.21-3.7.97.99-3.61-.23-.37a9.52 9.52 0 01-1.46-5.04c0-5.27 4.29-9.56 9.57-9.56a9.5 9.5 0 016.76 2.8 9.49 9.49 0 012.8 6.76c0 5.27-4.29 9.57-9.56 9.57zm5.24-7.13c-.29-.15-1.7-.84-1.96-.93-.26-.1-.45-.15-.64.15-.19.29-.74.93-.9 1.12-.17.19-.33.21-.62.07-.29-.15-1.23-.45-2.35-1.44-.87-.78-1.46-1.74-1.63-2.03-.17-.29-.02-.45.13-.6.13-.13.29-.33.44-.49.15-.17.2-.29.29-.49.1-.19.05-.37-.02-.52-.07-.15-.64-1.55-.88-2.13-.23-.55-.47-.48-.64-.49h-.55c-.19 0-.49.07-.74.33-.26.29-.99.97-.99 2.37 0 1.4 1.02 2.75 1.16 2.94.15.19 2.01 3.07 4.87 4.3.68.29 1.2.46 1.61.59.68.21 1.29.18 1.78.11.54-.08 1.7-.69 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.19-.55-.33z"/></svg>
        WhatsApp directo
      </a>
    </div>

    <form class="ezra-lead-form" id="ezra-lead-form">
      <span class="ezra-lead-form-label">Enviar mensaje</span>

      <div class="ezra-lead-row">
        <span class="ezra-eyebrow-wide">¿Qué te interesa?</span>
        <div class="ezra-chip-group" data-group="intent">
          <button type="button" class="ezra-chip" data-value="Vender">Quiero vender</button>
          <button type="button" class="ezra-chip" data-value="Rentar">Quiero rentar</button>
          <button type="button" class="ezra-chip" data-value="Comprar">Quiero comprar</button>
        </div>
      </div>

      <div class="ezra-lead-grid">
        <label>
          <span class="ezra-eyebrow-wide">Nombre</span>
          <input type="text" name="name" required minlength="2" placeholder="Tu nombre" />
        </label>
        <label>
          <span class="ezra-eyebrow-wide">Correo</span>
          <input type="email" name="email" required placeholder="tu@correo.com" />
        </label>
        <label>
          <span class="ezra-eyebrow-wide">WhatsApp</span>
          <input type="tel" name="phone" required pattern="[0-9 +\\-]{10,15}" placeholder="55 1234 5678" />
        </label>
      </div>

      <label class="ezra-lead-msg">
        <span class="ezra-eyebrow-wide">Mensaje</span>
        <textarea name="message" rows="3" placeholder="Cuéntanos sobre tu propiedad o lo que estás buscando…"></textarea>
      </label>

      <button type="submit" class="ezra-lead-cta">Enviar mensaje</button>
      <div class="ezra-lead-status" hidden></div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('ezra-lead-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('.ezra-lead-status');

    // Selector de intención: single-select.
    form.querySelectorAll<HTMLButtonElement>('[data-group="intent"] .ezra-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const on = chip.classList.contains('is-on');
        form.querySelectorAll<HTMLButtonElement>('[data-group="intent"] .ezra-chip')
          .forEach((c) => c.classList.remove('is-on'));
        if (!on) chip.classList.add('is-on');
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const intent = form.querySelector<HTMLButtonElement>('[data-group="intent"] .ezra-chip.is-on')?.dataset.value || '';
      const body = String(fd.get('message') || '').trim();

      const parts: string[] = [];
      if (intent) parts.push(`Interés: ${intent}`);
      if (body) parts.push(body);
      const message = parts.join(' — ') || 'Contacto desde el formulario.';

      const payload = {
        name: fd.get('name'),
        email: fd.get('email'),
        phone: fd.get('phone'),
        message,
      };

      const btn = form.querySelector<HTMLButtonElement>('.ezra-lead-cta');
      if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }
      try {
        const res = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error();
        if (status) {
          status.hidden = false;
          status.textContent = '¡Listo! Te contactaremos pronto.';
          status.classList.remove('is-err');
          status.classList.add('is-ok');
        }
        form.querySelectorAll<HTMLButtonElement>('.ezra-chip.is-on').forEach((c) => c.classList.remove('is-on'));
        form.reset();
        if (btn) { btn.textContent = 'Enviar mensaje'; btn.disabled = false; }
      } catch {
        if (status) {
          status.hidden = false;
          status.textContent = 'No pudimos enviar. Intenta por WhatsApp.';
          status.classList.remove('is-ok');
          status.classList.add('is-err');
        }
        if (btn) { btn.textContent = 'Reintentar'; btn.disabled = false; }
      }
    });
  }
</script>

<style>
  .ezra-lead { margin-top: 96px; padding: 0 32px; }
  .ezra-lead-inner {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1.5fr; gap: 64px;
    background: var(--ezra-surface);
    border: 1px solid var(--ezra-border);
    border-radius: var(--ezra-radius-xl);
    padding: 56px;
  }
  .ezra-lead-intro {
    position: sticky; top: 96px; align-self: start;
  }
  .ezra-lead-title {
    margin: 12px 0 16px;
    font-family: var(--ezra-font-display);
    font-size: 36px; font-weight: 600;
    color: var(--ezra-fg);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .ezra-lead-lede {
    font-size: 16px; line-height: 1.6;
    color: var(--ezra-fg-muted); max-width: 420px;
    font-weight: 300;
  }
  /* Botón WhatsApp: conserva el verde de marca (a propósito en otro color). */
  .ezra-lead-wa {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 28px; padding: 13px 20px;
    border-radius: var(--ezra-radius-md);
    background: #25D366; color: #fff;
    text-decoration: none;
    font-size: 14px; font-weight: 600;
    transition: opacity var(--ezra-dur-fast);
  }
  .ezra-lead-wa:hover { opacity: 0.9; }

  .ezra-lead-form { display: flex; flex-direction: column; gap: 22px; }
  .ezra-lead-form-label {
    font-size: 11px; font-weight: 500;
    letter-spacing: var(--ezra-track-wide); text-transform: uppercase;
    color: var(--ezra-fg-soft);
  }
  .ezra-lead-row { display: flex; flex-direction: column; gap: 10px; }
  .ezra-chip-group { display: flex; flex-wrap: wrap; gap: 8px; }

  .ezra-chip {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 16px;
    border-radius: var(--ezra-radius-pill);
    background: transparent;
    border: 1px solid var(--ezra-border-strong);
    color: var(--ezra-fg-muted);
    font-size: 13px; font-weight: 400; letter-spacing: 0.02em;
    cursor: pointer; font-family: inherit;
    transition: background var(--ezra-dur-fast),
                color var(--ezra-dur-fast),
                border-color var(--ezra-dur-fast);
  }
  .ezra-chip:hover { color: var(--ezra-fg); border-color: var(--ezra-fg); }
  .ezra-chip.is-on {
    background: var(--ezra-fg);
    color: var(--ezra-bg);
    border-color: var(--ezra-fg);
    font-weight: 500;
  }

  .ezra-lead-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
  }
  .ezra-lead-grid label,
  .ezra-lead-msg { display: flex; flex-direction: column; gap: 6px; }
  .ezra-lead-grid input,
  .ezra-lead-msg textarea {
    padding: 12px 14px; border-radius: var(--ezra-radius-md);
    border: 1px solid var(--ezra-border-strong);
    background: var(--ezra-input-bg);
    color: var(--ezra-fg);
    font-size: 14px; font-family: inherit;
  }
  .ezra-lead-msg textarea { resize: vertical; min-height: 96px; line-height: 1.5; }
  .ezra-lead-grid input:focus,
  .ezra-lead-msg textarea:focus {
    outline: none;
    border-color: var(--ezra-fg);
  }

  .ezra-lead-cta {
    margin-top: 4px; padding: 14px;
    background: var(--ezra-fg); color: var(--ezra-bg);
    border: none; border-radius: var(--ezra-radius-md); cursor: pointer;
    font-size: 13px; font-weight: 600; letter-spacing: 0.04em;
    transition: opacity var(--ezra-dur-fast);
  }
  .ezra-lead-cta:hover:not(:disabled) { opacity: 0.85; }
  .ezra-lead-cta:disabled { opacity: 0.5; cursor: not-allowed; }
  .ezra-lead-status { padding: 10px 12px; border-radius: var(--ezra-radius-md); font-size: 13px; }
  .ezra-lead-status.is-ok { background: rgba(92,122,110,0.18); color: var(--ezra-success); }
  .ezra-lead-status.is-err { background: rgba(176,90,78,0.18); color: var(--ezra-danger); }

  @media (max-width: 1024px) {
    .ezra-lead-inner { grid-template-columns: 1fr; padding: 40px 28px; gap: 32px; }
    .ezra-lead-intro { position: static; }
  }
  @media (max-width: 640px) {
    .ezra-lead { padding: 0 20px; }
    .ezra-lead-grid { grid-template-columns: 1fr; }
  }
</style>
