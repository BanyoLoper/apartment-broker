---
interface Props {
  whatsappNumber: string;
}
const { whatsappNumber } = Astro.props;
const waLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola, me interesa rentar un departamento.')}`;
---

<section id="contacto" class="ab-lead">
  <div class="ab-lead-inner">
    <div>
      <span class="ab-eyebrow">Contacto</span>
      <h2 class="ab-h2 ab-lead-title">¿No encuentras lo que buscas?</h2>
      <p class="ab-lead-lede">
        Cuéntanos qué necesitas. Te avisamos cuando salga algo en tus colonias y presupuesto.
      </p>
      <a href={waLink} class="ab-lead-wa" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5A11.7 11.7 0 0 0 12 0C5.4 0 0 5.4 0 12c0 2.1.6 4.2 1.6 6L0 24l6.2-1.6A12 12 0 0 0 12 24c6.6 0 12-5.4 12-12 0-3.2-1.2-6.2-3.5-8.5zM12 22c-1.9 0-3.7-.5-5.3-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A10 10 0 1 1 22 12c0 5.5-4.5 10-10 10zm5.5-7.5c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.3-.7.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.4.4-.5.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.7.4-.2.3-1 1-1 2.3 0 1.4 1 2.7 1.2 2.9.1.2 2 3.1 4.9 4.4 1.7.7 2.4.8 3.3.7.5-.1 1.7-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.5-.3z"/></svg>
        WhatsApp directo
      </a>
    </div>
    <form class="ab-lead-form" id="ab-lead-form">
      <label>
        <span class="ab-eyebrow">Nombre</span>
        <input type="text" name="name" required minlength="2" placeholder="Tu nombre" />
      </label>
      <label>
        <span class="ab-eyebrow">Correo</span>
        <input type="email" name="email" required placeholder="tu@correo.com" />
      </label>
      <label>
        <span class="ab-eyebrow">WhatsApp</span>
        <input type="tel" name="phone" required pattern="[0-9 +\\-]{10,15}" placeholder="55 1234 5678" />
      </label>
      <label>
        <span class="ab-eyebrow">¿Qué buscas?</span>
        <textarea name="message" rows="3" placeholder="Roma o Condesa, 2 recámaras, hasta $30,000..." minlength="6"></textarea>
      </label>
      <button type="submit" class="ab-lead-cta">Enviar mensaje</button>
      <div class="ab-lead-status" hidden></div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('ab-lead-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('.ab-lead-status');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());
      const btn = form.querySelector<HTMLButtonElement>('.ab-lead-cta');
      if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }
      try {
        const res = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error();
        if (status) {
          status.hidden = false;
          status.textContent = '¡Listo! Te contactaremos pronto.';
          status.classList.add('is-ok');
        }
        form.reset();
        if (btn) { btn.textContent = 'Enviar mensaje'; btn.disabled = false; }
      } catch {
        if (status) {
          status.hidden = false;
          status.textContent = 'No pudimos enviar. Intenta por WhatsApp.';
          status.classList.add('is-err');
        }
        if (btn) { btn.textContent = 'Reintentar'; btn.disabled = false; }
      }
    });
  }
</script>

<style>
  .ab-lead { margin-top: 96px; padding: 0 32px; }
  .ab-lead-inner {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px;
    background: #fff; border-radius: 22px; padding: 48px;
    border: 1px solid var(--ab-border);
    box-shadow: var(--ab-shadow-1);
  }
  .ab-lead-title { margin: 8px 0 12px; }
  .ab-lead-lede { font-size: 17px; color: var(--ab-stone-600); max-width: 440px; }
  .ab-lead-wa {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 24px; padding: 12px 18px; border-radius: 10px;
    background: #25D366; color: #fff; text-decoration: none;
    font-size: 14px; font-weight: 600;
  }
  .ab-lead-form { display: flex; flex-direction: column; gap: 14px; }
  .ab-lead-form label { display: flex; flex-direction: column; gap: 6px; }
  .ab-lead-form input, .ab-lead-form textarea {
    padding: 12px 14px; border-radius: 10px;
    border: 1px solid var(--ab-border-strong);
    background: var(--ab-bone-50);
    font-size: 15px;
  }
  .ab-lead-form textarea { resize: vertical; min-height: 90px; font-family: inherit; }
  .ab-lead-cta {
    margin-top: 4px; padding: 14px;
    background: var(--ab-ink-900); color: #fff;
    border: none; border-radius: 10px; cursor: pointer;
    font-size: 15px; font-weight: 600;
  }
  .ab-lead-cta:disabled { opacity: 0.6; cursor: not-allowed; }
  .ab-lead-status { padding: 10px 12px; border-radius: 8px; font-size: 14px; }
  .ab-lead-status.is-ok  { background: var(--ab-jade-100); color: var(--ab-jade-600); }
  .ab-lead-status.is-err { background: var(--ab-rosa-100); color: var(--ab-danger); }
  @media (max-width: 768px) {
    .ab-lead-inner { grid-template-columns: 1fr; padding: 32px 24px; gap: 32px; }
  }
</style>
