---
// Hero replicando el de ezrarealestate.com.mx: logo EZRA sobre render oscuro,
// claim, tres diferenciadores y dos llamadas a la acción.
const points = ['Clientes calificados', 'Promoción estratégica', 'Operaciones seguras'];
---

<section class="ezra-hero">
  <div class="ezra-hero-bg" style="background-image: url(/assets/ezra-hero-bg.png);"></div>
  <div class="ezra-hero-scrim"></div>

  <div class="ezra-hero-inner">
    <img
      class="ezra-hero-logo"
      src="/assets/ezra-hero-logo.png"
      alt="EZRA Real Estate"
      width="464"
      height="216"
    />
    <p class="ezra-hero-lede">Venta y Renta de propiedades en CDMX</p>

    <ul class="ezra-hero-points">
      {points.map((p) => (
        <li class="ezra-hero-point">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          <span>{p}</span>
        </li>
      ))}
    </ul>

    <div class="ezra-hero-actions">
      <a class="ezra-hero-btn ezra-hero-btn--primary" href="/departamentos">Ver propiedades</a>
      <a class="ezra-hero-btn ezra-hero-btn--ghost" href="#contacto">Publicar mi propiedad</a>
    </div>
  </div>
</section>

<style>
  .ezra-hero {
    position: relative; overflow: hidden;
    min-height: 92vh;
    display: flex; align-items: center; justify-content: center;
  }
  .ezra-hero-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: bottom center;
    filter: saturate(0.9) brightness(0.85);
    transform-origin: center;
    backface-visibility: hidden;
    will-change: transform, opacity;
    /* Un único movimiento de zoom-in que desacelera y se queda fijo
       (no hay vaivén ni pasos). El fade controla opacity; el zoom, transform. */
    animation:
      ezra-hero-fade 1400ms ease-out both,
      ezra-hero-zoom 7000ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes ezra-hero-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes ezra-hero-zoom {
    from { transform: scale(1); }
    to   { transform: scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ezra-hero-bg { animation: ezra-hero-fade 600ms ease both; transform: scale(1.04); }
  }
  .ezra-hero-scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to bottom, rgba(10,10,10,0.55) 0%, rgba(10,10,10,0.25) 40%, rgba(10,10,10,0.65) 100%);
  }

  .ezra-hero-inner {
    position: relative; z-index: 1;
    max-width: 760px; margin: 0 auto; padding: 96px 32px;
    width: 100%;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }

  .ezra-hero-logo {
    width: clamp(300px, 50vw, 560px);
    height: auto;
    margin-bottom: 12px;
    /* Logo recortado y transparente: se ve limpio sobre cualquier fondo. */
    filter: drop-shadow(0 2px 16px rgba(0,0,0,0.35));
  }

  .ezra-hero-lede {
    color: rgba(255,255,255,0.9);
    font-size: clamp(18px, 2.4vw, 24px);
    font-weight: 300;
    letter-spacing: 0.02em;
    margin: 0 0 40px;
  }

  .ezra-hero-points {
    list-style: none; margin: 0 0 44px; padding: 0;
    display: flex; flex-wrap: wrap; gap: 14px 36px;
    justify-content: center;
  }
  .ezra-hero-point {
    display: inline-flex; align-items: center; gap: 10px;
    color: rgba(255,255,255,0.92);
    font-size: 15px; font-weight: 400; letter-spacing: 0.02em;
  }
  .ezra-hero-point svg { color: var(--ezra-copper); flex-shrink: 0; }

  .ezra-hero-actions {
    display: flex; flex-wrap: wrap; gap: 14px; justify-content: center;
  }
  .ezra-hero-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 14px 28px; border-radius: var(--ezra-radius-md);
    font-size: 14px; font-weight: 600; letter-spacing: 0.04em;
    text-decoration: none; cursor: pointer;
    border: 1px solid transparent;
    transition: background var(--ezra-dur-fast) var(--ezra-ease-standard),
                color var(--ezra-dur-fast), border-color var(--ezra-dur-fast);
  }
  .ezra-hero-btn--primary { background: #FFF; color: var(--ezra-ink-900, #141414); }
  .ezra-hero-btn--primary:hover { background: rgba(255,255,255,0.85); }
  .ezra-hero-btn--ghost {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.45);
    color: #FFF;
    backdrop-filter: blur(8px);
  }
  .ezra-hero-btn--ghost:hover { background: rgba(255,255,255,0.18); border-color: #FFF; }

  @media (max-width: 768px) {
    .ezra-hero { min-height: 80vh; }
    .ezra-hero-inner { padding: 64px 24px; }
    .ezra-hero-actions { flex-direction: column; width: 100%; max-width: 320px; }
    .ezra-hero-btn { width: 100%; }
  }
</style>
