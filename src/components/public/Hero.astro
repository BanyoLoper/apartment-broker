---
// Hero EZRA: bloque editorial (Inter Black sobre charcoal) a la izquierda y una
// fotografía a sangre a la derecha que se funde con el fondo mediante degradado.
// La foto rota entre las propiedades publicadas, con un caption que se actualiza.
interface Slide { slug: string; name: string; colonia: string; price: number; image: string; }
interface Props { slides?: Slide[]; }
const { slides = [] } = Astro.props;

const fallback: Slide[] = [{
  slug: 'reforma-77', name: 'Reforma 77', colonia: 'Tabacalera', price: 56500,
  image: '/photos/reforma77/sala.jpg',
}];
const data: Slide[] = slides.length ? slides : fallback;
const points = ['Clientes calificados', 'Promoción estratégica', 'Operaciones seguras'];
---

<section class="ezra-hero">
  <div class="ezra-hero-inner">
    <div class="ezra-hero-content">
      <span class="ezra-eyebrow-wide ezra-hero-eyebrow">Venta y renta · CDMX</span>
      <h1 class="ezra-hero-title">
        Venta y renta <span class="ezra-hero-thin">de propiedades en</span> CDMX.
      </h1>
      <p class="ezra-hero-lede">
        Comercializamos propiedades residenciales con promoción estratégica y
        acompañamiento integral, hasta la formalización de la operación.
      </p>

      <div class="ezra-hero-actions">
        <a class="ezra-hero-btn ezra-hero-btn--primary" href="/departamentos">Ver propiedades</a>
        <a class="ezra-hero-btn ezra-hero-btn--ghost" href="#contacto">Publicar mi propiedad</a>
      </div>

      <ul class="ezra-hero-points">
        {points.map((p) => (
          <li class="ezra-hero-point">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="ezra-hero-media">
    {data.map((s, i) => (
      <img
        class={`ezra-hero-slide ${i === 0 ? 'is-active' : ''}`}
        src={s.image}
        alt={`${s.name}, ${s.colonia}`}
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
        data-slug={s.slug}
        data-name={s.name}
        data-colonia={s.colonia}
        data-price={s.price.toLocaleString('es-MX')}
      />
    ))}
    <div class="ezra-hero-media-scrim"></div>

    <a class="ezra-hero-cap" id="ezra-hero-cap" href={`/departamentos/${data[0].slug}`}>
      <span class="ezra-hero-cap-loc" id="hc-loc">{data[0].name} · Col. {data[0].colonia}</span>
      <span class="ezra-hero-cap-price" id="hc-price"><span>Renta</span> ${data[0].price.toLocaleString('es-MX')}</span>
    </a>

    {data.length > 1 && (
      <div class="ezra-hero-dots" id="ezra-hero-dots">
        {data.map((_, i) => <span class={`ezra-hero-dot ${i === 0 ? 'is-on' : ''}`}></span>)}
      </div>
    )}
  </div>
</section>

<script>
  const media = document.querySelector<HTMLElement>('.ezra-hero-media');
  if (media) {
    const slides = Array.from(media.querySelectorAll<HTMLImageElement>('.ezra-hero-slide'));
    const dots = Array.from(media.querySelectorAll<HTMLElement>('.ezra-hero-dot'));
    const cap = document.getElementById('ezra-hero-cap') as HTMLAnchorElement | null;
    const loc = document.getElementById('hc-loc');
    const price = document.getElementById('hc-price');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (slides.length > 1 && !reduce) {
      let i = 0;
      const show = (n: number) => {
        slides[i].classList.remove('is-active');
        dots[i]?.classList.remove('is-on');
        i = (n + slides.length) % slides.length;
        slides[i].classList.add('is-active');
        dots[i]?.classList.add('is-on');
        const d = slides[i].dataset;
        if (loc) loc.textContent = `${d.name} · Col. ${d.colonia}`;
        if (price) price.innerHTML = `<span>Renta</span> $${d.price}`;
        if (cap) cap.setAttribute('href', `/departamentos/${d.slug}`);
      };
      setInterval(() => show(i + 1), 5000);
    }
  }
</script>

<style>
  .ezra-hero {
    position: relative; overflow: hidden;
    background: var(--ezra-bg);
    min-height: 84vh; display: flex; align-items: center;
  }

  /* Fotografía a sangre a la derecha, fundida con el fondo */
  .ezra-hero-media {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 58%; z-index: 1;
  }
  .ezra-hero-slide {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0;
    transition: opacity 1400ms var(--ezra-ease-standard);
  }
  .ezra-hero-slide.is-active { opacity: 1; }
  .ezra-hero-media-scrim {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to right, var(--ezra-bg) 0%, rgba(20,20,20,0.55) 22%, rgba(20,20,20,0) 55%),
      linear-gradient(to top, rgba(15,15,15,0.6) 0%, rgba(15,15,15,0) 38%);
  }

  .ezra-hero-cap {
    position: absolute; left: 50%; bottom: 30px; transform: translateX(-50%); z-index: 2;
    display: inline-flex; flex-direction: column; align-items: center; gap: 4px;
    text-align: center;
    padding: 14px 18px; border-radius: var(--ezra-radius-md);
    background: rgba(15,15,15,0.42); color: #fff;
    border: 1px solid rgba(255,255,255,0.16);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    text-decoration: none;
    transition: background var(--ezra-dur-fast), border-color var(--ezra-dur-fast);
  }
  .ezra-hero-cap:hover { background: rgba(15,15,15,0.6); border-color: rgba(255,255,255,0.4); }
  .ezra-hero-cap-loc { font-size: 12px; font-weight: 300; letter-spacing: 0.04em; opacity: 0.9; }
  .ezra-hero-cap-price { font-family: var(--ezra-font-body); font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
  .ezra-hero-cap-price span { font-weight: 300; font-size: 13px; margin-right: 5px; opacity: 0.82; }

  .ezra-hero-dots {
    position: absolute; right: 28px; bottom: 34px; z-index: 2;
    display: flex; gap: 7px;
  }
  .ezra-hero-dot {
    width: 7px; height: 7px; border-radius: 999px;
    background: rgba(255,255,255,0.35);
    transition: background var(--ezra-dur-base), width var(--ezra-dur-base);
  }
  .ezra-hero-dot.is-on { background: #fff; width: 20px; }

  /* Contenido editorial a la izquierda */
  .ezra-hero-inner {
    position: relative; z-index: 2;
    max-width: 1280px; margin: 0 auto; width: 100%;
    padding: 96px 32px;
  }
  .ezra-hero-content { max-width: 540px; }
  .ezra-hero-eyebrow { color: rgba(255,255,255,0.55); }
  .ezra-hero-title {
    margin: 20px 0 26px; max-width: 12ch;
    font-family: var(--ezra-font-body); font-weight: 800;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 0.98; letter-spacing: -0.025em;
    color: #FFF; text-wrap: balance;
  }
  .ezra-hero-thin { font-weight: 200; color: rgba(255,255,255,0.92); }
  .ezra-hero-lede {
    margin: 0 0 36px; max-width: 460px;
    color: rgba(255,255,255,0.72);
    font-size: 17px; line-height: 1.55; font-weight: 300;
  }
  .ezra-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .ezra-hero-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 14px 26px; border-radius: var(--ezra-radius-md);
    font-size: 13px; font-weight: 600; letter-spacing: 0.04em;
    text-decoration: none; border: 1px solid transparent;
    transition: background var(--ezra-dur-fast), color var(--ezra-dur-fast), border-color var(--ezra-dur-fast);
  }
  .ezra-hero-btn--primary { background: #FFF; color: var(--ezra-ink-900); }
  .ezra-hero-btn--primary:hover { background: rgba(255,255,255,0.85); }
  .ezra-hero-btn--ghost { background: transparent; border-color: rgba(255,255,255,0.3); color: #FFF; }
  .ezra-hero-btn--ghost:hover { border-color: #FFF; background: rgba(255,255,255,0.06); }
  .ezra-hero-points {
    list-style: none; margin: 40px 0 0; padding: 32px 0 0;
    border-top: 1px solid var(--ezra-border);
    display: flex; flex-wrap: wrap; gap: 12px 28px;
  }
  .ezra-hero-point { display: inline-flex; align-items: center; gap: 9px; color: rgba(255,255,255,0.88); font-size: 14px; }
  .ezra-hero-point svg { color: var(--ezra-copper); flex-shrink: 0; }

  @media (max-width: 900px) {
    .ezra-hero { display: block; min-height: 0; }
    .ezra-hero-media {
      position: relative; width: 100%; height: 46vh; order: 2;
    }
    .ezra-hero-media-scrim {
      background:
        linear-gradient(to top, var(--ezra-bg) 0%, rgba(20,20,20,0) 45%),
        linear-gradient(to bottom, rgba(15,15,15,0.4) 0%, rgba(15,15,15,0) 40%);
    }
    .ezra-hero-inner { padding: 64px 24px 24px; }
    .ezra-hero-content { max-width: none; }
    .ezra-hero-cap { bottom: 22px; }
    .ezra-hero-dots { right: 20px; bottom: 26px; }
  }
</style>
