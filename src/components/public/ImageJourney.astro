---
interface Props {
  images: string[];
  has3d?: boolean;
  has360?: boolean;
}
const { images, has3d, has360 } = Astro.props;
const imgs = [...images];
while (imgs.length < 5) imgs.push(images[0] || '/photos/hamburgo-sala.jpg');
---

<section class="ezra-journey">
  <div class="ezra-journey-hero">
    <img src={imgs[0]} alt="" class="ezra-journey-img" loading="eager" />
    <div class="ezra-journey-scrim"></div>
    <div class="ezra-journey-actions">
      {has3d && (
        <button type="button" class="ezra-journey-chip ezra-journey-chip--accent" data-open-3d>
          <img src="/assets/icon-3d-room.svg" alt="" width="16" height="16" style="filter: brightness(0) invert(1);" />
          Recorrer en 3D
        </button>
      )}
      {has360 && (
        <button type="button" class="ezra-journey-chip ezra-journey-chip--ghost" data-open-360>
          <img src="/assets/icon-360.svg" alt="" width="16" height="16" />
          Vista 360°
        </button>
      )}
    </div>
    <div class="ezra-journey-tag">01 — Sala</div>
  </div>

  <div class="ezra-journey-pair ezra-journey-pair--a">
    <div class="ezra-journey-frame">
      <img src={imgs[1]} alt="" loading="lazy" />
      <div class="ezra-journey-tag">02 — Cocina</div>
    </div>
    <div class="ezra-journey-frame">
      <img src={imgs[2]} alt="" loading="lazy" />
      <div class="ezra-journey-tag">03 — Recámara</div>
    </div>
  </div>

  <div class="ezra-journey-pair ezra-journey-pair--b">
    <div class="ezra-journey-frame">
      <img src={imgs[3]} alt="" loading="lazy" />
      <div class="ezra-journey-tag">04 — Roof</div>
    </div>
    <div class="ezra-journey-frame">
      <img src={imgs[4]} alt="" loading="lazy" />
      <div class="ezra-journey-tag">05 — Fachada</div>
    </div>
  </div>
</section>

<style>
  .ezra-journey { margin-top: 32px; display: flex; flex-direction: column; gap: 18px; }
  .ezra-journey-hero {
    position: relative; border-radius: var(--ezra-radius-xl); overflow: hidden;
    aspect-ratio: 21/9;
  }
  .ezra-journey-img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .ezra-journey-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,10,10,0.55), transparent 50%);
    pointer-events: none;
  }
  .ezra-journey-actions {
    position: absolute; left: 24px; bottom: 20px;
    display: flex; gap: 8px;
  }
  .ezra-journey-chip {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 16px; border-radius: var(--ezra-radius-pill);
    border: 1px solid transparent; cursor: pointer;
    font-size: 12px; font-weight: 600; letter-spacing: 0.04em;
    backdrop-filter: blur(20px) saturate(1.2);
  }
  .ezra-journey-chip--accent { background: var(--ezra-copper); color: #FFF; }
  .ezra-journey-chip--ghost {
    background: rgba(255,255,255,0.12); color: #FFF;
    border-color: rgba(255,255,255,0.25);
  }
  .ezra-journey-tag {
    position: absolute; right: 24px; bottom: 20px;
    font-size: 11px; font-weight: 500;
    letter-spacing: var(--ezra-track-wide); text-transform: uppercase;
    color: rgba(255,255,255,0.85);
  }
  .ezra-journey-pair { display: grid; gap: 18px; }
  .ezra-journey-pair--a { grid-template-columns: 1.6fr 1fr; }
  .ezra-journey-pair--b { grid-template-columns: 1fr 1.4fr; }
  .ezra-journey-frame {
    position: relative; border-radius: var(--ezra-radius-lg); overflow: hidden;
    aspect-ratio: 4/3;
  }
  .ezra-journey-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ezra-journey-frame::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,10,10,0.4), transparent 55%);
    pointer-events: none;
  }
  .ezra-journey-frame .ezra-journey-tag { left: 16px; right: auto; bottom: 14px; z-index: 1; }
  @media (max-width: 768px) {
    .ezra-journey-pair--a, .ezra-journey-pair--b { grid-template-columns: 1fr; }
  }
</style>
