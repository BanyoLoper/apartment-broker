---
interface Props {
  active?: 'home' | 'listings' | 'colonias' | 'how';
}
const { active = 'home' } = Astro.props;
const links: { key: NonNullable<Props['active']>; href: string; label: string }[] = [
  { key: 'listings', href: '/departamentos', label: 'Departamentos' },
  { key: 'colonias', href: '/colonias', label: 'Colonias' },
  { key: 'how', href: '/como-funciona', label: 'Cómo funciona' },
];
---

<header class="ezra-header">
  <div class="ezra-header-inner">
    <a class="ezra-header-logo" href="/" aria-label="EZRA Real Estate — inicio">
      <img class="ezra-header-logo-img" src="/assets/ezra-logo-mark.png" alt="EZRA Real Estate" width="103" height="41" />
    </a>
    <nav class="ezra-header-nav">
      {links.map((l) => (
        <a class={`ezra-header-link ${active === l.key ? 'is-active' : ''}`} href={l.href}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .ezra-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklab, var(--ezra-bg) 88%, transparent);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border-bottom: 1px solid var(--ezra-border);
  }
  .ezra-header-inner {
    max-width: 1280px; margin: 0 auto; padding: 16px 32px;
    display: flex; align-items: center; gap: 32px;
  }

  .ezra-header-logo {
    display: inline-flex; align-items: center;
    text-decoration: none; line-height: 0;
  }
  .ezra-header-logo-img {
    height: 34px; width: auto; display: block;
  }

  .ezra-header-nav { display: flex; gap: 4px; margin-left: auto; }
  .ezra-header-link {
    font-size: 13px; font-weight: 400;
    color: var(--ezra-fg-muted); padding: 8px 12px; border-radius: var(--ezra-radius-sm);
    text-decoration: none;
    transition: color var(--ezra-dur-fast) var(--ezra-ease-standard);
  }
  .ezra-header-link:hover { color: var(--ezra-fg); }
  .ezra-header-link.is-active { color: var(--ezra-fg); }

  @media (max-width: 768px) {
    .ezra-header-nav { gap: 0; }
    .ezra-header-link { padding: 8px 8px; font-size: 12px; }
  }
</style>
