---
// Mapa split-view del listado público. Pins difusos con precio.
import type { Listing } from '../../lib/db';
interface Props { listings: Listing[]; }
const { listings } = Astro.props;
const points = listings
  .filter((l) => l.lat_fuzzy != null && l.lng_fuzzy != null)
  .map((l) => ({ id: l.id, slug: l.slug, name: l.name, lat: l.lat_fuzzy!, lng: l.lng_fuzzy!, price: l.price_mxn }));
---

<div id="ab-listings-map" class="ab-listings-map" data-points={JSON.stringify(points)}></div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script is:inline>
  (function () {
    function init() {
      if (typeof L === 'undefined') { setTimeout(init, 100); return; }
      const el = document.getElementById('ab-listings-map');
      if (!el) return;
      const points = JSON.parse(el.dataset.points || '[]');
      if (points.length === 0) {
        el.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--ab-stone-600);">Sin departamentos publicados todavía.</div>';
        return;
      }
      const center = [
        points.reduce((a, p) => a + p.lat, 0) / points.length,
        points.reduce((a, p) => a + p.lng, 0) / points.length,
      ];
      const map = L.map(el, { scrollWheelZoom: false }).setView(center, 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap', maxZoom: 19,
      }).addTo(map);
      points.forEach((p) => {
        const priceK = (p.price / 1000).toFixed(1) + 'k';
        const icon = L.divIcon({
          className: 'ab-price-pin',
          html: `<a href="/departamentos/${p.slug}" class="ab-price-pin-inner">$${priceK}</a>`,
          iconSize: [62, 26],
          iconAnchor: [31, 26],
        });
        L.marker([p.lat, p.lng], { icon }).addTo(map);
      });
    }
    if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
  })();
</script>

<style is:global>
  .ab-price-pin .ab-price-pin-inner {
    display: inline-block; padding: 5px 10px; border-radius: 999px;
    background: #fff; color: var(--ab-ink-900);
    font-family: var(--ab-font-mono); font-size: 12px; font-weight: 600;
    box-shadow: var(--ab-shadow-2); text-decoration: none;
  }
  .ab-price-pin .ab-price-pin-inner:hover { background: var(--ab-terracotta-500); color: #fff; }
</style>

<style>
  .ab-listings-map {
    width: 100%; height: 100%; min-height: 480px;
    border-radius: 14px; overflow: hidden;
    background: var(--ab-bone-100);
    box-shadow: inset 0 0 0 1px var(--ab-border);
  }
</style>
