---
import type { Listing } from '../../lib/db';
import { formatMxn } from '../../lib/db';

interface Props {
  listing: Listing;
  whatsappNumber: string;
}
const { listing, whatsappNumber } = Astro.props;

const days = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
const times = [
  '8:00 am', '9:00 am', '10:00 am', '11:00 am', '12:00 pm', '1:00 pm',
  '2:00 pm', '3:00 pm', '4:00 pm', '5:00 pm', '6:00 pm', '7:00 pm', '8:00 pm',
];
---

<aside class="ezra-booking">
  <div class="ezra-booking-price">
    <span class="ezra-booking-label">Renta</span>
    <span class="ezra-booking-amount">{formatMxn(listing.price_mxn)}</span>
    <span class="ezra-booking-per">/ mes</span>
  </div>
  {listing.utilities_included && (
    <p class="ezra-booking-utilities">{listing.utilities_included}</p>
  )}
  <p class="ezra-booking-sub">Renta directa con el dueño · sin comisión a inquilino</p>

  <div class="ezra-booking-visit">
    <span class="ezra-eyebrow-wide">Reservar visita</span>
    <p class="ezra-booking-hours">Lunes a domingo · 8:00 am – 8:00 pm</p>

    <div class="ezra-booking-field">
      <label class="ezra-booking-flabel" for="visit-day">Día</label>
      <select id="visit-day">
        {days.map((d) => <option value={d}>{d}</option>)}
      </select>
    </div>
    <div class="ezra-booking-field">
      <label class="ezra-booking-flabel" for="visit-time">Hora</label>
      <select id="visit-time">
        {times.map((t) => <option value={t}>{t}</option>)}
      </select>
    </div>

    <button
      type="button"
      id="visit-wa"
      class="ezra-booking-wa"
      data-wa={whatsappNumber}
      data-name={listing.name}
      data-colonia={listing.colonia}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.78 11.78 0 0012.06 0C5.48 0 .13 5.36.13 11.94c0 2.11.55 4.18 1.59 6.01L0 24l6.24-1.63a11.92 11.92 0 005.82 1.49h.01c6.58 0 11.94-5.36 11.94-11.94 0-3.19-1.24-6.19-3.49-8.44zM12.07 21.5h-.01a9.53 9.53 0 01-4.86-1.33l-.35-.21-3.7.97.99-3.61-.23-.37a9.52 9.52 0 01-1.46-5.04c0-5.27 4.29-9.56 9.57-9.56a9.5 9.5 0 016.76 2.8 9.49 9.49 0 012.8 6.76c0 5.27-4.29 9.57-9.56 9.57z"/></svg>
      Reservar por WhatsApp
    </button>
  </div>

  <div class="ezra-booking-rows">
    <div class="ezra-booking-row"><span>Depósito</span><span>1 mes</span></div>
    <div class="ezra-booking-row"><span>Contrato mín.</span><span>12 meses</span></div>
    <div class="ezra-booking-row"><span>Mantenimiento</span><span>Incluido</span></div>
    <div class="ezra-booking-row"><span>Mascotas</span><span>{listing.pet_friendly ? 'Permitidas' : 'No permitidas'}</span></div>
    <div class="ezra-booking-row"><span>Estacionamiento</span><span>{listing.parking ? `${listing.parking} cajón(es)` : 'No incluido'}</span></div>
  </div>
</aside>

<script>
  const btn = document.getElementById('visit-wa');
  if (btn) {
    btn.addEventListener('click', () => {
      const day = (document.getElementById('visit-day') as HTMLSelectElement | null)?.value || '';
      const time = (document.getElementById('visit-time') as HTMLSelectElement | null)?.value || '';
      const name = btn.dataset.name || 'el departamento';
      const colonia = btn.dataset.colonia || '';
      const num = btn.dataset.wa || '';
      const msg = `Hola, me interesa agendar una visita a ${name} (${colonia}).\nDía: ${day}\nHora: ${time}`;
      window.open(`https://wa.me/${num}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
    });
  }
</script>

<style>
  .ezra-booking {
    position: sticky; top: 96px; align-self: start;
    background: var(--ezra-surface); border: 1px solid var(--ezra-border);
    border-radius: var(--ezra-radius-lg);
    padding: 28px;
    color: var(--ezra-fg);
  }
  .ezra-booking-price {
    display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
  }
  .ezra-booking-label {
    font-size: 13px; font-weight: 300;
    color: var(--ezra-fg-muted); text-transform: lowercase;
  }
  .ezra-booking-amount {
    font-family: var(--ezra-font-body);
    font-weight: 800; font-size: 32px;
    letter-spacing: -0.02em; color: var(--ezra-fg);
  }
  .ezra-booking-per { font-size: 12px; color: var(--ezra-fg-muted); }
  .ezra-booking-utilities {
    margin: 6px 0 0;
    font-size: 11px; color: var(--ezra-fg-muted);
    letter-spacing: 0.04em;
  }
  .ezra-booking-sub {
    margin-top: 8px;
    font-size: 12px; color: var(--ezra-fg-soft);
  }

  .ezra-booking-visit {
    margin-top: 24px; display: flex; flex-direction: column; gap: 10px;
  }
  .ezra-booking-hours {
    margin: -2px 0 6px;
    font-size: 13px; color: var(--ezra-fg);
    font-family: var(--ezra-font-mono); letter-spacing: 0.02em;
  }
  .ezra-booking-field {
    padding: 8px 14px; border: 1px solid var(--ezra-border);
    border-radius: var(--ezra-radius-md);
    background: var(--ezra-input-bg);
    display: flex; flex-direction: column; gap: 2px;
  }
  .ezra-booking-flabel {
    font-size: 10px; font-weight: 500; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ezra-fg-soft);
  }
  .ezra-booking-field select {
    width: 100%; border: none; background: transparent;
    font-size: 14px; color: var(--ezra-fg);
    outline: none; padding: 0; cursor: pointer;
  }
  .ezra-booking-field select option { background: var(--ezra-bg); color: var(--ezra-fg); }

  .ezra-booking-wa {
    margin-top: 6px;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    padding: 14px; width: 100%;
    background: #25D366; color: #fff;
    border: none; border-radius: var(--ezra-radius-md);
    cursor: pointer; text-decoration: none;
    font-size: 14px; font-weight: 600; letter-spacing: 0.02em;
    font-family: inherit;
    transition: opacity var(--ezra-dur-fast);
  }
  .ezra-booking-wa:hover { opacity: 0.9; }

  .ezra-booking-rows {
    margin-top: 24px; padding-top: 16px;
    border-top: 1px solid var(--ezra-border);
    display: flex; flex-direction: column; gap: 10px;
  }
  .ezra-booking-row {
    display: flex; justify-content: space-between;
    font-size: 13px;
  }
  .ezra-booking-row > :first-child { color: var(--ezra-fg-muted); }
  .ezra-booking-row > :last-child { color: var(--ezra-fg); font-weight: 500; }
</style>
