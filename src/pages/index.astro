---
import PublicLayout from '../layouts/PublicLayout.astro';
import Hero from '../components/public/Hero.astro';
import ListingCard from '../components/public/ListingCard.astro';
import LeadForm from '../components/public/LeadForm.astro';
import type { Listing } from '../lib/db';

const env = Astro.locals.runtime?.env;
let featured: Listing[] = [];
if (env?.DB) {
  const active = await env.DB.prepare(
    "SELECT * FROM listings WHERE status = 'publicada' ORDER BY created_at DESC LIMIT 6",
  ).all();
  featured = (active.results as Listing[]) || [];
}
const whatsapp = env?.WHATSAPP_NUMBER || '525527846773';
---

<PublicLayout active="home">
  <Hero />

  <section class="ezra-section">
    <div class="ezra-section-inner">
      <header class="ezra-section-head">
        <div>
          <span class="ezra-eyebrow-wide">Disponibles ahora</span>
          <h2 class="ezra-section-title">Departamentos amueblados</h2>
        </div>
        <p class="ezra-section-sub">
          Cada inmueble es operado por EZRA. Mantenimiento, servicios e inventario boutique incluidos.
        </p>
      </header>

      <div class="ezra-grid">
        {featured.map((l, i) => <ListingCard listing={l} priority={i < 3} />)}
        {featured.length === 0 && (
          <div class="ezra-empty">
            Aún no hay depas publicados. Corre <code>npm run db:migrate:local && npm run db:seed:local</code>.
          </div>
        )}
      </div>

      <div class="ezra-section-cta">
        <a class="ezra-link" href="/departamentos">
          Ver todo el portafolio
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14 M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <LeadForm whatsappNumber={whatsapp} />
</PublicLayout>

<style>
  .ezra-section { padding: 96px 32px 0; }
  .ezra-section-inner { max-width: 1280px; margin: 0 auto; }
  .ezra-section-head {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 32px;
    margin-bottom: 48px;
  }
  .ezra-section-title {
    margin: 12px 0 0;
    font-family: var(--ezra-font-display);
    font-size: 44px; font-weight: 600;
    color: var(--ezra-fg);
    letter-spacing: -0.02em;
  }
  .ezra-section-sub {
    max-width: 360px;
    color: var(--ezra-fg-muted);
    font-size: 15px; line-height: 1.55; font-weight: 300;
    margin: 0;
  }
  .ezra-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }
  .ezra-empty {
    grid-column: 1 / -1;
    padding: 48px; text-align: center;
    color: var(--ezra-fg-muted);
    border: 1px dashed var(--ezra-border-strong);
    border-radius: var(--ezra-radius-lg);
  }
  .ezra-empty code {
    display: inline-block; margin-top: 4px; padding: 2px 6px;
    background: var(--ezra-surface); border-radius: var(--ezra-radius-sm);
    font-family: var(--ezra-font-mono); font-size: 12px;
  }
  .ezra-section-cta { margin-top: 48px; text-align: center; }
  .ezra-link {
    display: inline-flex; align-items: center; gap: 10px;
    color: var(--ezra-fg); font-weight: 500; font-size: 14px;
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: 12px 18px;
    border: 1px solid var(--ezra-border-strong);
    border-radius: var(--ezra-radius-md);
    transition: background var(--ezra-dur-fast), color var(--ezra-dur-fast);
  }
  .ezra-link:hover {
    background: var(--ezra-fg);
    color: var(--ezra-bg);
  }
  @media (max-width: 768px) {
    .ezra-section-head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .ezra-section-title { font-size: 32px; }
  }
</style>
