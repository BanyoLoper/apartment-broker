---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ListingsMap from '../../components/public/ListingsMap.astro';
import type { Listing } from '../../lib/db';

const url = new URL(Astro.request.url);
const colonia = url.searchParams.get('colonia') || '';
const beds = url.searchParams.get('beds') || '';
const maxPrice = Number(url.searchParams.get('max_price') || 0);

const env = Astro.locals.runtime?.env;
let results: Listing[] = [];
const mediaByListing = new Map<number, string[]>();
if (env?.DB) {
  const conds = ["status = 'publicada'"];
  const binds: (string | number)[] = [];
  if (colonia) { conds.push('colonia = ?'); binds.push(colonia); }
  if (beds) {
    const minBeds = parseInt(beds.replace(/\D/g, ''), 10) || 0;
    if (minBeds > 0) { conds.push('beds >= ?'); binds.push(minBeds); }
  }
  if (maxPrice > 0) { conds.push('price_mxn <= ?'); binds.push(maxPrice); }
  const sql = `SELECT * FROM listings WHERE ${conds.join(' AND ')} ORDER BY price_mxn ASC`;
  const rs = await env.DB.prepare(sql).bind(...binds).all();
  results = (rs.results as unknown as Listing[]) || [];

  if (results.length) {
    const ids = results.map((l) => l.id);
    const ph = ids.map(() => '?').join(',');
    const ms = await env.DB.prepare(
      `SELECT listing_id, url FROM listing_media WHERE kind = 'photo' AND listing_id IN (${ph}) ORDER BY listing_id, position`,
    ).bind(...ids).all();
    for (const row of (ms.results as unknown as { listing_id: number; url: string }[])) {
      const arr = mediaByListing.get(row.listing_id) ?? [];
      arr.push(row.url);
      mediaByListing.set(row.listing_id, arr);
    }
  }
}

function specsOf(l: Listing): string {
  return [`${l.area_m2} m²`, `${l.beds} rec`, `${l.baths} baño`, l.parking ? `${l.parking} estac` : null]
    .filter(Boolean).join(' · ');
}

const items = results
  .filter((l) => l.lat_fuzzy != null && l.lng_fuzzy != null)
  .map((l) => {
    const cover = l.cover_image || '/assets/placeholder-apt-1.svg';
    const imgs = mediaByListing.get(l.id);
    return {
      id: l.id, slug: l.slug, name: l.name, colonia: l.colonia,
      lat: l.lat_fuzzy!, lng: l.lng_fuzzy!, price: l.price_mxn,
      specs: specsOf(l),
      images: (imgs && imgs.length) ? imgs : [cover],
    };
  });
---

<PublicLayout active="listings" title="Departamentos · EZRA Real Estate">
  <main class="ezra-listings">
    <header class="ezra-listings-head">
      <div>
        <span class="ezra-eyebrow-wide">{results.length} {results.length === 1 ? 'departamento' : 'departamentos'}</span>
        <h1 class="ezra-listings-title">{colonia || 'CDMX completa'}</h1>
      </div>
    </header>

    <div class="ezra-listings-grid">
      <div class="ezra-listings-list">
        {items.map((it) => (
          <button class="ezra-mini" type="button" data-select={it.id}>
            <span class="ezra-mini-photo"><img src={it.images[0]} alt={it.name} loading="lazy" /></span>
            <span class="ezra-mini-body">
              <span class="ezra-mini-loc">{it.name} · Col. {it.colonia}</span>
              <span class="ezra-mini-specs">{it.specs}</span>
            </span>
            <span class="ezra-mini-price">
              <span class="ezra-mini-price-amount">${it.price.toLocaleString('es-MX')}</span>
              <span class="ezra-mini-price-per">/ mes</span>
            </span>
          </button>
        ))}
        {items.length === 0 && (
          <div class="ezra-empty">No hay depas con esos filtros. Cambia algún criterio.</div>
        )}
      </div>
      <div class="ezra-listings-map-wrap">
        <ListingsMap items={items} />
      </div>
    </div>
  </main>
</PublicLayout>

<script is:inline>
  // Click en una tarjeta de la izquierda → centra el mapa y abre el desglose.
  document.querySelectorAll('[data-select]').forEach((b) => {
    b.addEventListener('click', () => {
      const id = Number(b.getAttribute('data-select'));
      if (window.ezraMapSelect) window.ezraMapSelect(id);
    });
  });
</script>

<style>
  .ezra-listings { max-width: 1280px; margin: 0 auto; padding: 64px 32px; }
  .ezra-listings-head { margin-bottom: 32px; }
  .ezra-listings-title {
    margin: 8px 0 0;
    font-family: var(--ezra-font-display);
    font-size: 56px; font-weight: 600;
    color: var(--ezra-fg);
    letter-spacing: -0.02em;
  }
  .ezra-listings-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 32px;
    align-items: start;
  }
  .ezra-listings-list { display: flex; flex-direction: column; gap: 12px; }

  .ezra-mini {
    display: grid; grid-template-columns: 96px 1fr auto; gap: 14px; align-items: center;
    width: 100%; text-align: left;
    padding: 10px; border: 1px solid var(--ezra-border);
    border-radius: var(--ezra-radius-lg); background: var(--ezra-surface);
    cursor: pointer; color: inherit; font-family: inherit;
    transition: border-color var(--ezra-dur-fast) var(--ezra-ease-standard),
                transform var(--ezra-dur-fast);
  }
  .ezra-mini:hover { border-color: var(--ezra-border-strong); transform: translateY(-1px); }
  .ezra-mini-photo {
    width: 96px; height: 96px; border-radius: var(--ezra-radius-md);
    overflow: hidden; display: block; background: var(--ezra-ink-900);
  }
  .ezra-mini-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ezra-mini-body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .ezra-mini-loc {
    font-size: 13px; font-weight: 600; color: var(--ezra-fg);
    letter-spacing: -0.005em; line-height: 1.3;
  }
  .ezra-mini-specs {
    font-size: 12px; color: var(--ezra-fg-muted);
    font-family: var(--ezra-font-mono); letter-spacing: 0.02em;
  }
  .ezra-mini-price {
    display: flex; flex-direction: column; align-items: flex-end;
    text-align: right; padding-right: 6px; white-space: nowrap;
  }
  .ezra-mini-price-amount {
    font-family: var(--ezra-font-body);
    font-size: 17px; font-weight: 800; letter-spacing: -0.02em;
    color: var(--ezra-fg); line-height: 1;
  }
  .ezra-mini-price-per {
    margin-top: 4px;
    font-size: 11px; color: var(--ezra-fg-muted);
  }

  @media (max-width: 420px) {
    .ezra-mini { grid-template-columns: 80px 1fr; }
    .ezra-mini-price { grid-column: 2; align-items: flex-start; text-align: left; padding-right: 0; }
    .ezra-mini-price-amount { font-size: 15px; }
  }

  .ezra-listings-map-wrap { position: sticky; top: 96px; align-self: start; }

  .ezra-empty {
    padding: 48px; text-align: center;
    color: var(--ezra-fg-muted);
    border: 1px dashed var(--ezra-border-strong);
    border-radius: var(--ezra-radius-lg);
  }
  @media (max-width: 1024px) {
    .ezra-listings-grid { grid-template-columns: 1fr; }
    .ezra-listings-map-wrap { position: static; order: -1; }
    .ezra-listings-title { font-size: 40px; }
  }
  @media (max-width: 640px) {
    .ezra-listings { padding: 48px 20px; }
  }
</style>
