---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ImageJourney from '../../components/public/ImageJourney.astro';
import BookingPanel from '../../components/public/BookingPanel.astro';
import NearbyMap from '../../components/public/NearbyMap.astro';
import Viewer360 from '../../components/public/Viewer360.astro';
import Showroom3D from '../../components/public/Showroom3D.astro';
import Feat from '../../components/public/Feat.astro';
import AmenityIcon from '../../components/public/AmenityIcon.astro';
import type { Listing } from '../../lib/db';
import { parseAmenities } from '../../lib/db';
import { googleMapsLink } from '../../lib/geo';

const { slug } = Astro.params;
const env = Astro.locals.runtime?.env;
let listing: Listing | null = null;
if (env?.DB && slug) {
  listing = await env.DB.prepare('SELECT * FROM listings WHERE slug = ? AND status != ?')
    .bind(slug, 'borrador').first() as Listing | null;
}
if (!listing) return Astro.redirect('/departamentos');

const amenities = parseAmenities(listing.amenities);
const cover = listing.cover_image || '/photos/hamburgo-sala.jpg';
const images = [
  cover,
  '/photos/hamburgo-sala-2.jpg',
  '/photos/hamburgo-comedor.jpg',
  cover,
  '/photos/hamburgo-sala-2.jpg',
];
const whatsapp = env?.WHATSAPP_NUMBER || '525527846773';
const fuzzyLat = listing.lat_fuzzy ?? 19.4326;
const fuzzyLng = listing.lng_fuzzy ?? -99.1332;
const radius = Number(env?.PUBLIC_FUZZY_RADIUS_M || 150);
const subtype = listing.furnished ? 'Depto. Amueblado' : 'Departamento';
---

<PublicLayout title={`${listing.name} · ${listing.colonia} · EZRA`} active="listings">
  <main class="ezra-detail">
    <a class="ezra-back" href="/departamentos">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
      Volver al portafolio
    </a>

    <header class="ezra-detail-head">
      <div>
        <span class="ezra-eyebrow-wide">{listing.colonia}{listing.floor != null && ` · piso ${listing.floor}`}</span>
        <h1 class="ezra-detail-title">{listing.name}</h1>
        <p class="ezra-detail-subtitle">
          <strong>{subtype}</strong> {listing.tagline ? <span>· {listing.tagline}</span> : null}
        </p>
        <div class="ezra-detail-meta">
          {listing.area_m2} m² · {listing.beds} rec · {listing.baths} baño{listing.parking ? ` · ${listing.parking} estac` : ''}
          {listing.available_at && ` · disponible ${listing.available_at}`}
        </div>
      </div>
      <div class="ezra-detail-actions">
        <a class="ezra-detail-icbtn" href={googleMapsLink(fuzzyLat, fuzzyLng, listing.colonia)} target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Ver zona en Google Maps
        </a>
      </div>
    </header>

    <ImageJourney images={images} has3d={!!listing.has_3d} has360={!!listing.has_360} />

    <div class="ezra-detail-grid">
      <section>
        <span class="ezra-eyebrow-wide">Sobre el departamento</span>
        <h2 class="ezra-detail-h2">{listing.tagline || `Una experiencia en ${listing.colonia}`}</h2>
        <p class="ezra-detail-desc">{listing.description}</p>

        <div class="ezra-feats">
          <Feat label="Recámaras" v={String(listing.beds)} />
          <Feat label="Baños" v={String(listing.baths)} />
          <Feat label="Superficie" v={`${listing.area_m2} m²`} />
          <Feat label="Piso" v={listing.floor != null ? String(listing.floor) : '—'} />
          <Feat label="Mascotas" v={listing.pet_friendly ? 'Sí' : 'No'} />
          <Feat label="Estacionamiento" v={listing.parking ? `${listing.parking} cajón(es)` : 'No'} />
          <Feat label="Disponible" v={listing.available_at || '—'} />
          <Feat label="Renta" v={`$${listing.price_mxn.toLocaleString('es-MX')}`} />
        </div>

        {listing.utilities_included && (
          <div class="ezra-utilities">
            <span class="ezra-eyebrow-wide">Servicios incluidos</span>
            <p>{listing.utilities_included}</p>
          </div>
        )}

        {amenities.length > 0 && (
          <div class="ezra-amenities">
            <span class="ezra-eyebrow-wide">Amenidades del edificio</span>
            <div class="ezra-amenities-grid">
              {amenities.map((f) => (
                <div class="ezra-amenity">
                  <span class="ezra-amenity-bullet">
                    <AmenityIcon text={f} size={20} stroke={1.4} />
                  </span>
                  <span>{f}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </section>
      <BookingPanel listing={listing} whatsappNumber={whatsapp} />
    </div>

    <NearbyMap fuzzyLat={fuzzyLat} fuzzyLng={fuzzyLng} fuzzyRadiusM={radius} listingName={listing.name} />
  </main>

  {listing.has_360 && <Viewer360 title={`${listing.name} · ${listing.colonia}`} />}
  {listing.has_3d && <Showroom3D title={`${listing.name} · ${listing.colonia}`} modelUrl={listing.model_glb_url || undefined} />}
</PublicLayout>

<style>
  .ezra-detail { max-width: 1280px; margin: 0 auto; padding: 32px 32px 64px; }
  .ezra-back {
    background: transparent; border: none; cursor: pointer; padding: 4px 0;
    font-size: 12px; color: var(--ezra-fg-muted); text-decoration: none;
    display: inline-flex; align-items: center; gap: 8px;
    letter-spacing: 0.06em; text-transform: uppercase; font-weight: 500;
    transition: color var(--ezra-dur-fast);
  }
  .ezra-back:hover { color: var(--ezra-fg); }
  .ezra-detail-head {
    margin-top: 24px; display: flex; justify-content: space-between;
    align-items: flex-end; gap: 32px;
  }
  .ezra-detail-title {
    margin: 12px 0 4px;
    font-family: var(--ezra-font-display);
    font-size: 64px; font-weight: 600;
    color: var(--ezra-fg);
    letter-spacing: -0.02em; line-height: 1.05;
  }
  .ezra-detail-subtitle {
    margin: 6px 0 12px;
    color: var(--ezra-fg);
    font-size: 18px; font-weight: 300;
  }
  .ezra-detail-subtitle strong { font-weight: 700; }
  .ezra-detail-meta {
    color: var(--ezra-fg-muted);
    font-family: var(--ezra-font-mono);
    font-size: 13px;
  }
  .ezra-detail-actions { display: flex; gap: 8px; }
  .ezra-detail-icbtn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 16px; border-radius: var(--ezra-radius-md);
    background: transparent;
    border: 1px solid var(--ezra-border-strong);
    color: var(--ezra-fg-muted);
    font-size: 12px; font-weight: 500; letter-spacing: 0.04em;
    text-decoration: none;
    transition: color var(--ezra-dur-fast), border-color var(--ezra-dur-fast);
  }
  .ezra-detail-icbtn:hover { color: var(--ezra-fg); border-color: var(--ezra-fg); }

  .ezra-detail-grid {
    display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px;
    margin-top: 80px;
  }
  .ezra-detail-h2 {
    margin: 12px 0 16px;
    font-family: var(--ezra-font-display);
    font-size: 36px; font-weight: 600;
    color: var(--ezra-fg);
    letter-spacing: -0.01em;
  }
  .ezra-detail-desc {
    font-size: 17px; color: var(--ezra-fg-muted);
    margin-top: 16px; max-width: 580px;
    line-height: 1.65; font-weight: 300;
  }
  .ezra-feats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .ezra-utilities { margin-top: 48px; }
  .ezra-utilities p {
    margin-top: 8px;
    font-size: 16px; color: var(--ezra-fg);
    font-family: var(--ezra-font-mono);
    letter-spacing: 0.02em;
  }
  .ezra-amenities { margin-top: 56px; }
  .ezra-amenities-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px 24px;
    margin-top: 20px;
  }
  .ezra-amenity {
    font-size: 14px; color: var(--ezra-fg);
    display: flex; align-items: center; gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--ezra-border);
    font-weight: 300;
    line-height: 1.3;
  }
  .ezra-amenity-bullet {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px;
    border-radius: 999px;
    background: rgba(194,106,63,0.10);
    color: var(--ezra-copper);
    flex-shrink: 0;
  }
  :root[data-theme='light'] .ezra-amenity-bullet {
    background: rgba(194,106,63,0.10);
  }
  @media (max-width: 1024px) {
    .ezra-detail-grid { grid-template-columns: 1fr; gap: 40px; }
    .ezra-feats { grid-template-columns: repeat(2, 1fr); }
    .ezra-amenities-grid { grid-template-columns: repeat(2, 1fr); }
    .ezra-detail-title { font-size: 44px; }
  }
  @media (max-width: 640px) {
    .ezra-detail-head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .ezra-detail-title { font-size: 36px; }
  }
</style>
