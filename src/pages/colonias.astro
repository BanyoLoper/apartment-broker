---
import PublicLayout from '../layouts/PublicLayout.astro';
import LeadForm from '../components/public/LeadForm.astro';

const env = Astro.locals.runtime?.env;

interface Row { colonia: string; n: number; min_price: number; max_price: number; }
let counts: Row[] = [];
if (env?.DB) {
  const rs = await env.DB.prepare(`
    SELECT colonia, COUNT(*) as n, MIN(price_mxn) as min_price, MAX(price_mxn) as max_price
    FROM listings WHERE status = 'publicada'
    GROUP BY colonia ORDER BY n DESC
  `).all();
  counts = (rs.results as unknown as Row[]) || [];
}

const descriptions: Record<string, { tag: string; body: string; image: string }> = {
  'Progreso Tizapán': {
    tag: 'C.U., áreas verdes, San Ángel',
    body: 'Al sur de la ciudad, a 8 minutos de Ciudad Universitaria y a un paso de San Ángel. Zona arbolada y tranquila, con condominios de amenidades amplias y vistas abiertas hacia las áreas verdes del sur.',
    image: '/photos/pedregal/estudio.png',
  },
  'Tabacalera': {
    tag: 'Reforma, Revolución, central',
    body: 'Sobre Paseo de la Reforma, junto al Monumento a la Revolución y a un paso del centro. Torres de altura con vista panorámica, perfecta conexión y vida urbana a pie de calle.',
    image: '/photos/reforma77/sala.jpg',
  },
};

const known = ['Progreso Tizapán', 'Tabacalera'];
const cards = known.map((name) => ({
  name,
  ...descriptions[name],
  count: counts.find((c) => c.colonia === name)?.n ?? 0,
  min: counts.find((c) => c.colonia === name)?.min_price ?? null,
}));

const whatsapp = env?.WHATSAPP_NUMBER || '525527846773';
---

<PublicLayout active="colonias" title="Colonias · EZRA Real Estate">
  <main class="ezra-colonias">
    <header class="ezra-colonias-head">
      <span class="ezra-eyebrow-wide">Dónde estamos</span>
      <h1 class="ezra-colonias-title">Donde opera EZRA en CDMX</h1>
      <p class="ezra-colonias-lede">
        Operamos solo donde podemos garantizar tiempos de mantenimiento, seguridad y conectividad. Cada inmueble lo administramos directo — no subcontratamos.
      </p>
    </header>

    <div class="ezra-colonias-grid">
      {cards.map((c) => (
        <a class="ezra-col-card" href={`/departamentos?colonia=${encodeURIComponent(c.name)}`}>
          <div class="ezra-col-card-frame">
            <img src={c.image} alt={c.name} class="ezra-col-card-img" loading="lazy" />
            <div class="ezra-col-card-scrim"></div>
            <div class="ezra-col-card-overlay">
              <span class="ezra-eyebrow-wide ezra-col-card-tag">{c.tag}</span>
              <h3 class="ezra-col-card-name">{c.name}</h3>
            </div>
            {c.count > 0 && (
              <div class="ezra-col-card-count">{c.count} {c.count === 1 ? 'depa' : 'depas'}</div>
            )}
          </div>
          <div class="ezra-col-card-body">
            <p>{c.body}</p>
            {c.min != null && (
              <div class="ezra-col-card-from">
                <span class="ezra-col-card-from-label">desde</span>
                <span class="ezra-col-card-from-amount">MXN ${c.min.toLocaleString('es-MX')}</span>
                <span class="ezra-col-card-from-per">/ mes</span>
              </div>
            )}
            <span class="ezra-col-card-cta">
              Ver disponibles
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14 M13 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <section class="ezra-colonias-cta">
      <span class="ezra-eyebrow-wide">¿Buscas otra zona?</span>
      <h2 class="ezra-colonias-cta-title">Nos avisas y vemos qué se puede.</h2>
      <p>Solo expandimos a colonias donde podemos operar bien. Si vives ahí o quieres que abramos, dinos qué buscas.</p>
    </section>

    <LeadForm whatsappNumber={whatsapp} />
  </main>
</PublicLayout>

<style>
  .ezra-colonias { max-width: 1280px; margin: 0 auto; padding: 64px 32px 0; }
  .ezra-colonias-head { max-width: 720px; margin-bottom: 64px; }
  .ezra-colonias-title {
    margin: 16px 0;
    font-family: var(--ezra-font-display);
    font-size: 56px; font-weight: 600;
    color: var(--ezra-fg); letter-spacing: -0.02em;
  }
  .ezra-colonias-lede {
    font-size: 18px; color: var(--ezra-fg-muted);
    line-height: 1.55; font-weight: 300;
  }

  .ezra-colonias-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
  }
  .ezra-col-card {
    background: var(--ezra-surface);
    border: 1px solid var(--ezra-border);
    border-radius: var(--ezra-radius-lg);
    overflow: hidden;
    text-decoration: none; color: inherit;
    display: flex; flex-direction: column;
    transition: transform var(--ezra-dur-base) var(--ezra-ease-standard),
                box-shadow var(--ezra-dur-base) var(--ezra-ease-standard);
  }
  .ezra-col-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--ezra-shadow-2);
  }
  .ezra-col-card-frame {
    position: relative; aspect-ratio: 16/10; overflow: hidden;
  }
  .ezra-col-card-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ezra-col-card-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,10,10,0.62), transparent 55%);
  }
  .ezra-col-card-overlay {
    position: absolute; left: 20px; bottom: 16px; right: 20px;
    display: flex; flex-direction: column; gap: 4px;
  }
  .ezra-col-card-tag { color: rgba(255,255,255,0.78); }
  .ezra-col-card-name {
    margin: 0;
    font-family: var(--ezra-font-display);
    font-size: 32px; font-weight: 600;
    color: #FFF; letter-spacing: -0.01em; line-height: 1;
  }
  .ezra-col-card-count {
    position: absolute; top: 16px; right: 16px;
    padding: 4px 10px; border-radius: var(--ezra-radius-pill);
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(10px);
    font-size: 11px; font-weight: 600; color: #141414;
  }
  .ezra-col-card-body {
    padding: 24px; flex: 1;
    display: flex; flex-direction: column; gap: 12px;
  }
  .ezra-col-card-body p {
    margin: 0;
    color: var(--ezra-fg-muted); font-size: 14px;
    line-height: 1.55; font-weight: 300; flex: 1;
  }
  .ezra-col-card-from {
    display: flex; align-items: baseline; gap: 6px;
    font-size: 13px;
  }
  .ezra-col-card-from-label { color: var(--ezra-fg-muted); }
  .ezra-col-card-from-amount {
    font-family: var(--ezra-font-body); font-weight: 700;
    color: var(--ezra-fg); font-size: 18px;
    letter-spacing: -0.01em;
  }
  .ezra-col-card-from-per { color: var(--ezra-fg-muted); }
  .ezra-col-card-cta {
    margin-top: 8px;
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--ezra-copper); font-weight: 600; font-size: 13px;
    letter-spacing: 0.04em;
  }

  .ezra-colonias-cta {
    margin-top: 96px; max-width: 720px;
  }
  .ezra-colonias-cta-title {
    margin: 12px 0;
    font-family: var(--ezra-font-display);
    font-size: 36px; font-weight: 600;
    color: var(--ezra-fg); letter-spacing: -0.01em;
  }
  .ezra-colonias-cta p {
    color: var(--ezra-fg-muted); font-size: 16px; line-height: 1.55;
    font-weight: 300; margin: 0;
  }
  @media (max-width: 640px) {
    .ezra-colonias-title { font-size: 36px; }
  }
</style>
