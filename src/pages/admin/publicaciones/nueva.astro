---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import TopBar from '../../../components/admin/TopBar.astro';
import Field from '../../../components/admin/Field.astro';
import Toggle from '../../../components/admin/Toggle.astro';

const session = Astro.locals.session;
---

<AdminLayout title="Nueva publicación" active="listings" brokerName={session?.name}>
  <TopBar title="Nueva publicación" subtitle="Wizard en 3 pasos" />

  <div class="ab-wizard">
    <div class="ab-wizard-steps">
      <div class="ab-step is-active" data-step="1"><span class="ab-step-num">1</span> Datos</div>
      <span class="ab-step-sep"></span>
      <div class="ab-step" data-step="2"><span class="ab-step-num">2</span> Imágenes · 3D · 360°</div>
      <span class="ab-step-sep"></span>
      <div class="ab-step" data-step="3"><span class="ab-step-num">3</span> Publicar</div>
    </div>

    <form id="ab-wizard-form" method="post" action="/api/listings">
      <section class="ab-step-panel" data-step="1">
        <div class="ab-form-grid">
          <Field label="Nombre interno"><input name="name" required placeholder="Casa Sonora" /></Field>
          <Field label="Slug (URL)"><input name="slug" required placeholder="casa-sonora" pattern="[a-z0-9\\-]+" /></Field>
          <Field label="Colonia">
            <select name="colonia" required>
              <option>Roma Norte</option>
              <option>Condesa</option>
              <option>Juárez</option>
              <option>Polanco</option>
              <option>Cuauhtémoc</option>
            </select>
          </Field>
          <Field label="Calle y número"><input name="street" /></Field>
          <Field label="Piso"><input name="floor" type="number" min="0" /></Field>
          <Field label="Recámaras"><input name="beds" type="number" min="0" required /></Field>
          <Field label="Baños"><input name="baths" type="number" min="0" required /></Field>
          <Field label="Superficie (m²)"><input name="area_m2" type="number" min="1" required /></Field>
          <Field label="Renta mensual (MXN)"><input name="price_mxn" type="number" min="1" required /></Field>
          <Field label="Latitud"><input name="lat_real" type="number" step="any" placeholder="19.4148" /></Field>
          <Field label="Longitud"><input name="lng_real" type="number" step="any" placeholder="-99.1675" /></Field>
          <div class="ab-form-full">
            <Field label="Tagline (overlay editorial de la tarjeta)">
              <input name="tagline" placeholder="Estilo hotel boutique" maxlength="80" />
            </Field>
          </div>
          <div class="ab-form-full">
            <Field label="Servicios incluidos en la renta">
              <input name="utilities_included" placeholder="mtto + gas + luz + agua + internet" />
            </Field>
          </div>
          <div class="ab-form-full" style="display: flex; gap: 16px;">
            <label style="display: flex; align-items: center; gap: 8px; font-size: 14px;">
              <input type="checkbox" name="furnished" checked /> Departamento amueblado
            </label>
          </div>
          <div class="ab-form-full">
            <Field label="Descripción">
              <textarea name="description" rows="4" placeholder="Suite boutique en torre Capitalia..."></textarea>
            </Field>
          </div>
        </div>
      </section>

      <section class="ab-step-panel" data-step="2" hidden>
        <div class="ab-uploads">
          {[1, 2, 3, 4, 5, 6].map((i) => (
            <div class="ab-upload-slot">
              <span class="ab-upload-num">{i.toString().padStart(2, '0')}</span>
              <button type="button" class="ab-upload-btn">+ Subir foto</button>
              <span class="ab-caption">JPG/PNG · máx 8MB</span>
            </div>
          ))}
        </div>
        <div class="ab-upload-grid">
          <div class="ab-upload-card">
            <img src="/assets/icon-3d-room.svg" alt="" width="22" height="22" />
            <div>
              <div class="ab-h4">Tour 3D</div>
              <div class="ab-caption">Sube un .glb o vincula un escaneo Matterport</div>
              <input type="text" name="model_glb_url" placeholder="URL del archivo .glb" />
            </div>
          </div>
          <div class="ab-upload-card">
            <img src="/assets/icon-360.svg" alt="" width="22" height="22" />
            <div>
              <div class="ab-h4">Vistas 360°</div>
              <div class="ab-caption">Una panorámica equirectangular por habitación</div>
              <button type="button" class="ab-upload-btn">+ Agregar 360</button>
            </div>
          </div>
        </div>
        <div class="ab-mock-note">
          Para el mock no se sube archivo real — los assets viven en R2 al pasar a producción.
        </div>
      </section>

      <section class="ab-step-panel" data-step="3" hidden>
        <div class="ab-publish-card">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ab-jade-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 L9 17 L4 12"/></svg>
          <div>
            <div class="ab-publish-title">Listo para publicar</div>
            <div class="ab-publish-sub">La publicación será visible en el sitio público en menos de 5 minutos.</div>
          </div>
        </div>
        <div class="ab-toggles">
          <Toggle label="Permitir reservar visitas inmediatamente" name="allow_bookings" defaultChecked />
          <Toggle label="Aparecer en la página de inicio" name="featured" defaultChecked />
          <Toggle label="Notificar a inquilinos en lista de espera" name="notify_waitlist" />
        </div>
      </section>

      <div class="ab-wizard-bar">
        <button type="button" class="ab-wizard-btn ab-wizard-btn--ghost" id="ab-wizard-prev">Cancelar</button>
        <button type="button" class="ab-wizard-btn ab-wizard-btn--primary" id="ab-wizard-next">Continuar</button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const steps = document.querySelectorAll<HTMLElement>('.ab-step-panel');
  const indicators = document.querySelectorAll<HTMLElement>('.ab-step');
  const next = document.getElementById('ab-wizard-next');
  const prev = document.getElementById('ab-wizard-prev');
  let current = 1;
  function show(n: number) {
    current = n;
    steps.forEach((s) => { s.hidden = Number(s.dataset.step) !== n; });
    indicators.forEach((i) => i.classList.toggle('is-active', Number(i.dataset.step) <= n));
    if (next) next.textContent = n === 3 ? 'Publicar' : 'Continuar';
    if (prev) prev.textContent = n === 1 ? 'Cancelar' : 'Atrás';
  }
  next?.addEventListener('click', () => {
    if (current === 3) { (document.getElementById('ab-wizard-form') as HTMLFormElement).requestSubmit(); return; }
    show(current + 1);
  });
  prev?.addEventListener('click', () => {
    if (current === 1) { window.location.href = '/admin/publicaciones'; return; }
    show(current - 1);
  });
</script>

<style>
  .ab-wizard { padding: 24px 32px 64px; max-width: 960px; margin: 0 auto; }
  .ab-wizard-steps {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 20px; margin-bottom: 24px;
    background: #fff; border: 1px solid var(--ab-border); border-radius: 8px;
  }
  .ab-step { display: flex; align-items: center; gap: 8px; color: var(--ab-stone-400); font-size: 13px; font-weight: 600; }
  .ab-step-num {
    width: 24px; height: 24px; border-radius: 999px;
    border: 1.5px solid var(--ab-border-strong);
    color: var(--ab-stone-400); display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700;
  }
  .ab-step.is-active { color: var(--ab-ink-900); }
  .ab-step.is-active .ab-step-num { background: var(--ab-terracotta-500); border-color: var(--ab-terracotta-500); color: #fff; }
  .ab-step-sep { width: 32px; height: 1px; background: var(--ab-border-strong); }

  .ab-form-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 18px;
    background: #fff; padding: 28px; border-radius: 8px;
    border: 1px solid var(--ab-border);
  }
  .ab-form-full { grid-column: 1 / -1; }
  .ab-uploads {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
    background: #fff; padding: 20px; border-radius: 8px;
    border: 1px solid var(--ab-border);
  }
  .ab-upload-slot {
    aspect-ratio: 4/3; border: 1.5px dashed var(--ab-border-strong);
    border-radius: 4px; padding: 12px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    color: var(--ab-stone-600); cursor: pointer;
    background: var(--ab-bone-50);
  }
  .ab-upload-num { font: var(--ab-text-eyebrow); }
  .ab-upload-btn {
    padding: 8px 14px; border-radius: 4px; font-size: 12px; font-weight: 500;
    letter-spacing: 0.04em;
    border: 1px solid var(--ezra-border-strong); background: var(--ezra-surface);
    color: var(--ezra-fg); cursor: pointer;
  }
  .ab-upload-btn:hover { border-color: var(--ezra-fg); }
  .ab-upload-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;
  }
  .ab-upload-card {
    padding: 16px; border: 1px solid var(--ab-border-strong);
    border-radius: 8px; display: flex; gap: 14px; align-items: flex-start;
    background: #fff;
  }
  .ab-upload-card input {
    margin-top: 8px; padding: 8px 10px; border: 1px solid var(--ab-border);
    border-radius: 8px; width: 100%; font-size: 13px;
  }
  .ab-mock-note {
    margin-top: 16px; padding: 12px 16px; background: var(--ab-bone-100);
    border-radius: 8px; color: var(--ab-stone-600); font-size: 13px;
  }
  .ab-publish-card {
    padding: 18px; background: var(--ab-jade-100); border-radius: 8px;
    display: flex; gap: 12px; align-items: flex-start;
  }
  .ab-publish-title { font-weight: 600; color: var(--ab-jade-600); }
  .ab-publish-sub { font-size: 14px; color: var(--ab-stone-600); margin-top: 4px; }
  .ab-toggles {
    margin-top: 20px; display: flex; flex-direction: column; gap: 12px;
  }
  .ab-wizard-bar {
    margin-top: 24px;
    display: flex; justify-content: space-between;
  }
  .ab-wizard-btn {
    padding: 12px 22px; border-radius: 4px; font-size: 13px; font-weight: 500;
    letter-spacing: 0.04em;
    border: 1px solid transparent; cursor: pointer;
    transition: background var(--ezra-dur-fast), color var(--ezra-dur-fast);
  }
  .ab-wizard-btn--ghost {
    background: transparent;
    border-color: var(--ezra-border-strong);
    color: var(--ezra-fg-muted);
  }
  .ab-wizard-btn--ghost:hover { color: var(--ezra-fg); border-color: var(--ezra-fg); }
  .ab-wizard-btn--primary { background: var(--ezra-fg); color: var(--ezra-bg); }
  .ab-wizard-btn--primary:hover { opacity: 0.85; }
</style>
