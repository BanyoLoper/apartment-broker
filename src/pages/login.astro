---
import '../styles/tokens.css';

const url = new URL(Astro.request.url);
const error = url.searchParams.get('error');
const redirect = url.searchParams.get('redirect') || '/admin';
const errorMsg = error === 'credenciales' ? 'Correo o contraseña incorrectos.'
  : error === 'campos' ? 'Completa todos los campos.'
  : null;
---

<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Acceso brokers · EZRA Real Estate</title>
  <link rel="icon" type="image/jpeg" href="/assets/ezra-icon.jpg" />
</head>
<body class="ezra-login-body">
  <main class="ezra-login">
    <a href="/" class="ezra-login-back">← Volver al sitio</a>
    <div class="ezra-login-card">
      <a href="/" class="ezra-login-mark">
        <span class="ezra-login-name">EZRA</span>
        <span class="ezra-login-sub">Real Estate</span>
      </a>
      <span class="ezra-eyebrow-wide">Admin Console</span>
      <h1 class="ezra-login-title">Acceso brokers</h1>
      <p class="ezra-login-lede">Solo personal autorizado de EZRA.</p>

      {errorMsg && <div class="ezra-login-err">{errorMsg}</div>}

      <form method="post" action="/api/auth/login" class="ezra-login-form">
        <input type="hidden" name="redirect" value={redirect} />
        <label>
          <span class="ezra-eyebrow-wide">Correo</span>
          <input type="email" name="email" required autofocus value="broker@example.com" />
        </label>
        <label>
          <span class="ezra-eyebrow-wide">Contraseña</span>
          <input type="password" name="password" required />
        </label>
        <button type="submit">Entrar</button>
      </form>

      <p class="ezra-login-help">
        Demo: <code>broker@example.com</code> + <code>ADMIN_PASSWORD</code> de <code>.dev.vars</code>.
      </p>
    </div>
  </main>

  <style>
    .ezra-login-body {
      min-height: 100vh; background: #0A0A0A; margin: 0;
      color: #FFF;
    }
    .ezra-login {
      min-height: 100vh; display: flex; flex-direction: column;
      align-items: center; justify-content: center; padding: 24px;
    }
    .ezra-login-back {
      align-self: flex-start; padding: 8px 12px;
      color: rgba(255,255,255,0.62);
      text-decoration: none; font-size: 12px; margin-bottom: 16px;
      letter-spacing: 0.06em; text-transform: uppercase; font-weight: 500;
    }
    .ezra-login-back:hover { color: #FFF; }
    .ezra-login-card {
      width: 100%; max-width: 420px;
      background: #141414;
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: var(--ezra-radius-xl);
      padding: 48px 40px;
      display: flex; flex-direction: column; gap: 6px;
      align-items: flex-start;
    }
    .ezra-login-mark {
      display: flex; flex-direction: column; gap: 1px;
      line-height: 1; text-decoration: none;
      margin-bottom: 24px;
    }
    .ezra-login-name {
      font-family: var(--ezra-font-display);
      font-size: 32px; font-weight: 500;
      letter-spacing: 0.32em; color: #FFF;
      padding-left: 0.32em;
    }
    .ezra-login-sub {
      font-size: 9px; font-weight: 500;
      letter-spacing: 0.42em; text-transform: uppercase;
      color: rgba(255,255,255,0.62);
    }
    .ezra-login-title {
      font-family: var(--ezra-font-display);
      font-size: 36px; font-weight: 600;
      color: #FFF;
      margin: 4px 0 0; letter-spacing: -0.01em;
    }
    .ezra-login-lede {
      color: rgba(255,255,255,0.62); margin: 4px 0 24px;
      font-size: 14px; font-weight: 300;
    }
    .ezra-login-form { display: flex; flex-direction: column; gap: 16px; width: 100%; }
    .ezra-login-form label { display: flex; flex-direction: column; gap: 6px; }
    .ezra-login-form input {
      padding: 12px 14px;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: var(--ezra-radius-md);
      background: rgba(255,255,255,0.04);
      color: #FFF;
      font-size: 14px;
      font-family: inherit;
    }
    .ezra-login-form input:focus {
      outline: none;
      border-color: #FFF;
    }
    .ezra-login-form button {
      margin-top: 12px; padding: 14px;
      background: #FFF; color: #141414;
      border: none; border-radius: var(--ezra-radius-md); cursor: pointer;
      font-size: 13px; font-weight: 600;
      letter-spacing: 0.04em;
    }
    .ezra-login-form button:hover { opacity: 0.85; }
    .ezra-login-err {
      padding: 10px 12px; border-radius: var(--ezra-radius-md);
      background: rgba(176,90,78,0.18); border: 1px solid var(--ezra-danger);
      color: var(--ezra-danger);
      font-size: 13px; margin: 8px 0;
      width: 100%;
    }
    .ezra-login-help {
      margin-top: 16px; font-size: 11px;
      color: rgba(255,255,255,0.45);
      line-height: 1.5;
    }
    .ezra-login-help code {
      font-family: var(--ezra-font-mono); font-size: 11px;
      background: rgba(255,255,255,0.06); padding: 2px 5px;
      border-radius: var(--ezra-radius-sm);
      color: #FFF;
    }
  </style>
</body>
</html>
