---
import '../styles/tokens.css';
import Header from '../components/public/Header.astro';
import Footer from '../components/public/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'listings' | 'colonias' | 'how';
}
const {
  title = 'EZRA Real Estate — Departamentos amueblados en CDMX',
  description = 'EZRA opera y renta departamentos amueblados estilo hotel boutique en Roma, Condesa, Juárez y Polanco. Renta directa con el dueño.',
  active = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#F1ECE2" media="(prefers-color-scheme: light)" />
  <link rel="icon" type="image/jpeg" href="/assets/ezra-icon.jpg" />
  <script is:inline>
    // Aplica el tema antes del primer paint para evitar flash
    (function () {
      try {
        const t = localStorage.getItem('ezra-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) { /* SSR / no localStorage */ }
    })();
  </script>
</head>
<body>
  <Header active={active} />
  <slot />
  <Footer />
</body>
</html>
