---
import '../styles/tokens.css';
import Header from '../components/public/Header.astro';
import Footer from '../components/public/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'listings' | 'colonias' | 'how';
}
const {
  title = 'ApartmentBroker — Renta directa en CDMX',
  description = 'Departamentos curados en Roma, Condesa, Juárez y Polanco. Renta directa con el dueño, sin comisiones.',
  active = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/assets/logo-mark.svg" />
</head>
<body>
  <Header active={active} />
  <slot />
  <Footer />
</body>
</html>
