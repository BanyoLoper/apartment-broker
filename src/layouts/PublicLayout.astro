---
import '../styles/tokens.css';
import Header from '../components/public/Header.astro';
import Footer from '../components/public/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const {
  title = 'EZRA Real Estate — Departamentos amueblados en CDMX',
  description = 'EZRA opera y renta departamentos amueblados estilo hotel boutique en CDMX — Progreso Tizapán (frente a C.U.) y Tabacalera (Paseo de la Reforma). Renta directa con el dueño.',
  active = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#292929" />
  <link rel="icon" type="image/jpeg" href="/assets/ezra-icon.jpg" />
</head>
<body>
  <Header active={active} />
  <slot />
  <Footer />
</body>
</html>
